{
  "name": "@soramitsu-ui/ui",
  "version": "2.0.0",
  "main": "dist/lib.cjs",
  "module": "dist/lib.mjs",
  "types": "dist/lib.d.ts",
  "license": "Apache-2.0",
  "sideEffects": [
    "./dist/style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/lib.mjs",
      "require": "./dist/lib.cjs",
      "types": "./dist/lib.d.ts"
    },
    "./styles": "./dist/style.css"
  },
  "scripts": {
    "sb:build": "storybook build",
    "sb:serve": "storybook dev -p 6006 --disable-telemetry",
    "sb:test": "bash scripts/run-storybook-test.sh",
    "test:unit": "vitest run",
    "test:after-build": "vitest run -c vitest.after-build.config.ts",
    "cy": "node ./scripts/run-cypress.cjs open",
    "cy:ci:component": "node ./scripts/run-cypress.cjs run --component --quiet --reporter spec",
    "typecheck": "vue-tsc --noEmit",
    "build": "run-s build:clean build:tsc build:vite api:extract",
    "build:clean": "del dist dist-ts",
    "build:tsc": "vue-tsc --outDir dist-ts --declaration --emitDeclarationOnly && node ./scripts/postprocess-dts.mjs",
    "build:vite": "vite build",
    "api:extract": "api-extractor run --typescript-compiler-folder ../../../../node_modules/typescript",
    "api:extract:local": "api-extractor run --local"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@vue-kakuyaku/core": "^0.4.3",
    "@vueuse/core": "^13.9.0",
    "@vueuse/math": "^13.9.0",
    "date-fns": "4.1.0",
    "escape-string-regexp": "^5.0.0",
    "focus-trap": "^7.6.5",
    "jsoneditor": "^10.4.1",
    "lodash-es": "^4.17.21",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.393",
    "@mdx-js/react": "^3.1.1",
    "@microsoft/api-extractor": "^7.53.1",
    "@soramitsu-ui/icons": "0.1.0",
    "@soramitsu-ui/theme": "0.3.0",
    "@soramitsu-ui/vite-plugin-svg": "0.1.0",
    "@storybook/addon-actions": "9.1.0-alpha.5",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/test-runner": "^0.23.0",
    "@storybook/vue3": "^9.1.10",
    "@storybook/vue3-vite": "^9.1.10",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/jsoneditor": "^9.9.6",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "19.2.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.3",
    "body-scroll-lock": "^4.0.0-beta.0",
    "cypress": "^15.4.0",
    "cypress-axe": "^1.7.0",
    "del-cli": "^7.0.0",
    "esbuild": "^0.25.10",
    "esbuild-register": "^3.6.0",
    "happy-dom": "^19.0.2",
    "immer": "^10.1.3",
    "npm-run-all": "^4.1.5",
    "pinia": "^3.0.3",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.93.2",
    "storybook": "^9.1.10",
    "tabbable": "^6.2.0",
    "type-fest": "^5.0.1",
    "typescript": "~5.8.2",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-icons": "^22.4.2",
    "vite": "^7.1.9",
    "vite-plugin-windicss": "^1.9.4",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^3.2.4",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.1",
    "windicss": "^3.5.6"
  }
}
