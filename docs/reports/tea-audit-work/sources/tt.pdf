	gap: 12px;
}

.section-slider .carousel-navigation {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 15px;
	z-index: 15;
	display: flex;
	justify-content: center;
	list-style: none;
	padding-left: 0;
	margin-bottom: 0;
}

.section-slider .carousel-navigation li {
	margin: 0;
}

.section-slider .carousel-navigation button {
	background-color: rgba(255, 255, 255, 0.5);
	border: 0;
	width: 30px;
	height: 3px;
	margin-left: 3px;
	margin-right: 3px;
	padding: 0;
	cursor: pointer;
}

.section-slider .carousel-navigation button:focus {
	outline: 0;
}

.section-slider .carousel-navigation button.active {
	background-color: rgba(255, 255, 255, 1);
}

@keyframes moveLeftActive {
	from { transform: translateX(0); }
	to { transform: translateX(100%); }
}

@keyframes moveLeft {
	from { transform: translateX(-100%); }
	to { transform: translateX(0); }
}

@keyframes moveRightActive {
	from { transform: translateX(0); }
	to { transform: translateX(-100%); }
}

@keyframes moveRight {
	from { transform: translateX(100%); }
	to { transform: translateX(0); }
}

.section-slider .carousel-item.active.move-left {
	animation-name: moveLeftActive;
}

.section-slider .carousel-item.move-left {
	animation-name: moveLeft;
}

.section-slider .carousel-item.active.move-right {
	animation-name: moveRightActive;
}

.section-slider .carousel-item.move-right {
	animation-name: moveRight;
}

@media (max-width: 767.98px) {
	.section-slider .carousel-inner {
		height: 70vh;
		min-height: 420px;
	}

	.section-slider .carousel-caption {
		top: auto;
		bottom: 60px;
		left: 0;
		right: 0;
		transform: none;
		padding-left: 15px;
		padding-right: 15px;
	}

	.section-slider .carousel-caption .col-12 {
		max-width: 100%;
	}

	.section-slider .carousel-caption h1 {
		font-size: 1.75rem;
		margin-bottom: 10px;
	}

	.section-slider .carousel-caption .lead {
		margin-bottom: 16px;
		font-size: 1rem;
	}

	.cl-banner-buttons {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 10px;
		width: 100%;
	}

	.cl-banner-buttons .btn,
	.section-slider .carousel-caption > .btn,
	.section-slider .carousel-caption a.btn {
		width: 100%;
		max-width: 100%;
	}
}</style><script>(function() {var configuration = {}; var fragmentElement = document.querySelector('#fragment-9502-wfak'); var fragmentNamespace = 'wfak';const MOVE_LEFT = 'move-left';
const MOVE_RIGHT = 'move-right';
const INTERVAL = 5000;
const ANIMATION_DURATION = 600;

const editMode = document.body.classList.contains('has-edit-mode-menu');
const indicators = Array.from(
	fragmentElement.querySelectorAll('.carousel-navigation button')
);
const items = Array.from(
	fragmentElement.querySelectorAll('.carousel-item')
);

let moving = false;

function scrollToContent(event) {
	if (event) {
		event.preventDefault();
	}

	const element = document.getElementById('discover');

	if (element) {
		element.scrollIntoView({
			block: 'start',
			behavior: 'smooth'
		});
	}
}

function getActiveIndicator() {
	return fragmentElement.querySelector('.carousel-navigation button.active');
}

function getActiveItem() {
	return fragmentElement.querySelector('.carousel-item.active');
}

function getNextIndex(currentIndex) {
	return currentIndex >= items.length - 1 ? 0 : currentIndex + 1;
}

function move(movement, index = null) {
	if (moving || !items.length) {
		return;
	}

	const activeItem = getActiveItem();
	const activeIndicator = getActiveIndicator();

	if (!activeItem || !activeIndicator) {
		return;
	}

	const activeIndex = items.indexOf(activeItem);
	let nextIndex = index;

	if (nextIndex === null) {
		nextIndex = getNextIndex(activeIndex);
	}

	if (
		nextIndex === activeIndex ||
		nextIndex < 0 ||
		nextIndex >= items.length
	) {
		return;
	}

	const nextItem = items[nextIndex];

	moving = true;

	activeItem.classList.add(movement);
	nextItem.classList.add(movement);

	activeIndicator.classList.remove('active');
	indicators[nextIndex].classList.add('active');

	setTimeout(function () {
		activeItem.classList.remove('active', MOVE_LEFT, MOVE_RIGHT);
		nextItem.classList.remove(MOVE_LEFT, MOVE_RIGHT);
		nextItem.classList.add('active');

		moving = false;
	}, ANIMATION_DURATION);
}

function createInterval() {
	let intervalId = null;

	if (!editMode) {
		intervalId = setInterval(function () {
			if (document.contains(fragmentElement) && items.length && document.contains(items[0])) {
				move(MOVE_RIGHT);
			}
			else {
				clearInterval(intervalId);
			}
		}, INTERVAL);
	}

	return intervalId;
}

(function main() {
	let intervalId = createInterval();

	indicators.forEach(function (indicator, index) {
		indicator.addEventListener('click', function () {
			const activeIndicator = getActiveIndicator();
			const activeIndex = indicators.indexOf(activeIndicator);

			if (index !== activeIndex) {
				if (index < activeIndex) {
					move(MOVE_LEFT, index);
				}
				else {
					move(MOVE_RIGHT, index);
				}
			}

			clearInterval(intervalId);
			intervalId = createInterval();
		});
	});
})();

window.scrollToContent = scrollToContent;;}());</script>
