</div></div><style>#cl-home-banner {
	width: 100vw;
	position: relative;
	left: 50%;
	right: 50%;
	margin-left: -50vw;
	margin-right: -50vw;
	overflow: hidden;
	background: #000;
}

#cl-home-banner,
#cl-home-banner .carousel,
#cl-home-banner .carousel-inner {
	padding-left: 0 !important;
	padding-right: 0 !important;
}

.section-slider {
	position: relative;
	width: 100%;
	background: #000;
}

.section-slider .carousel {
	position: relative;
}

.section-slider .carousel-inner {
	position: relative;
	height: 60vh;
	min-height: 400px;
	background: #000;
	transform: translateZ(0);
	overflow: hidden;
}

.section-slider .carousel-item {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	opacity: 0;
	backface-visibility: hidden;
}

.section-slider .carousel-item.active,
.section-slider .carousel-item.move-left,
.section-slider .carousel-item.move-right {
	opacity: 1;
	display: block;
}

.section-slider .carousel-item.active {
	z-index: 2;
}

.section-slider .carousel-item.move-left,
.section-slider .carousel-item.move-right {
	z-index: 3;
	animation-duration: 0.6s;
	animation-iteration-count: 1;
	animation-fill-mode: both;
}

.section-slider .cl-banner-image,
.section-slider .carousel-item img,
.section-slider .carousel-item .w-100 {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	filter: brightness(50%);
	backface-visibility: hidden;
}

.section-slider .carousel-caption {
