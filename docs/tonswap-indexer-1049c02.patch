+  /** Proves campaign block identity against the primary finalized mainnet before certifying coverage. */
+  private async validateTonswapBlockIdentity(blockHeight: number, signedBlock: FetchedBlock['signedBlock']): Promise<void> {
+    if (!this.api || this.api.genesisHash?.toString() !== TONSWAP_MAINNET_GENESIS) {
+      throw new Error('TONSWAP campaign requires SORA mainnet');
+    }
+    const blockApi = await this.getBlockDataApi();
