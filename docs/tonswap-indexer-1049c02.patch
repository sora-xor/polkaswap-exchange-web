+      documents.push(createTonswapBurnCoverage(batchEnd,
+        last.signedBlock.block.header.hash.toString().toLowerCase(), last.timestamp));
+      if (this.isStopping()) return;
+      await this.repository.upsertMany(documents);
+    }
