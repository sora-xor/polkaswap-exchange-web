+      throw new Error('TONSWAP archive is not SORA mainnet');
+    }
+    const expectedHash = (await this.withRpcTimeout(
+      () => this.api!.rpc.chain.getBlockHash(blockHeight), `TONSWAP primary block ${blockHeight}`
+    )).toString().toLowerCase();
+    const actualHash = signedBlock.block.header.hash.toString().toLowerCase();
+    if (signedBlock.block.header.number.toNumber() !== blockHeight ||
+      !isCanonicalTonswapBlockHash(expectedHash) || actualHash !== expectedHash) {
