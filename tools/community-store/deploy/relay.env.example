# Store in a private owner-only file outside source control. No wallet spending key exists.
SORA_PAY_CONFIG=/Users/administrator/apps/sora-pay/private/merchant.json
SORA_PAY_DB=/Users/administrator/apps/sora-pay/private/orders.sqlite
SORA_PAY_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_AS_64_HEX
SORA_PAY_OPERATOR_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_AS_HEX
SORA_PAY_PORT=39848
# Set 1 ONLY after nginx overwrites X-Sora-Pay-Client-IP with $remote_addr on every proxied route.
# The default 0 never trusts client-supplied forwarding headers.
SORA_PAY_TRUST_LOOPBACK_PROXY=0
# Set one transport before enabled=true. Telegram is a PRIVATE volunteer chat, not a public channel.
SORA_PAY_NOTIFY=telegram
SORA_PAY_TELEGRAM_TOKEN=
SORA_PAY_TELEGRAM_CHAT_ID=
# SMTP alternative: implicit TLS with a valid server certificate.
# SORA_PAY_NOTIFY=email
# SORA_PAY_SMTP_HOST=
# SORA_PAY_SMTP_PORT=465
# SORA_PAY_SMTP_USER=
# SORA_PAY_SMTP_PASSWORD=
# SORA_PAY_EMAIL_FROM=
# SORA_PAY_EMAIL_TO=
# Backup key must be separate from the database encryption key and kept off-host.
# SORA_PAY_BACKUP_KEY=
# SORA_PAY_BACKUP_PATH=/private-backup-destination/orders-2026-09-25.enc
