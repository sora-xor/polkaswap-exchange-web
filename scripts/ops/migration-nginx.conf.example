# Include the zone in the approved host's existing nginx http context.
limit_req_zone $binary_remote_addr zone=migration_intake:1m rate=6r/m;
limit_req_zone $binary_remote_addr zone=migration_probe:1m rate=30r/m;

# Add this exact location to the existing approved HTTPS server. Keep other services intact.
location = /api/migration {
    limit_req zone=migration_intake burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 4k;
    client_body_timeout 10s;
    access_log off;
    error_log /dev/null;
    proxy_pass http://127.0.0.1:5193;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    # Overwrite any caller-supplied value. The relay trusts this only from loopback.
    proxy_set_header X-Migration-Client-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
}

# Tiny first-party HTTP latency probe; never cache it or write request logs.
location = /api/migration/ping {
    limit_req zone=migration_probe burst=10 nodelay;
    limit_req_status 429;
    client_max_body_size 1k;
    client_body_timeout 3s;
    access_log off;
    error_log /dev/null;
    proxy_pass http://127.0.0.1:5193;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Connection "";
    proxy_connect_timeout 1s;
    proxy_read_timeout 3s;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
}
