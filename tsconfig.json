{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node", "telegram-web-app"],
    "paths": {
      "@/*": ["src/*"],
      "@stubs/*": ["tests/stubs/*"],
      "@tests/*": ["tests/*"],
      "@/lib/soraneo-wallet/lib/soraneo-wallet-web.css": ["src/lib/soraneo-wallet/lib/soraneo-wallet-web.css"],
      "@/lib/soraneo-wallet/src/core": ["src/lib/soraneo-wallet/src/core.ts"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "tests/**/*.ts", "tests/**/*.tsx", "electron/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
