  font-size: 10px !important;
  padding: 10px 15px !important;
}
.wallet-settings-create-token .ipfs-tooltip__icon {
  color: var(--s-color-base-content-tertiary);
}
.wallet-settings-create-token .ipfs-tooltip__icon:hover {
  cursor: pointer;
  color: var(--s-color-base-content-secondary);
}
.wallet-settings-create-token_desc {
  color: var(--s-color-base-content-primary);
  font-size: var(--s-font-size-extra-small);
  font-weight: 300;
  line-height: var(--s-line-height-base);
  padding: var(--s-basic-spacing) calc(var(--s-basic-spacing) * 1.5) calc(var(--s-basic-spacing) * 2);
}
.wallet-settings-create-token_action {
  margin-top: calc(var(--s-basic-spacing) * 2);
  width: 100%;
}
.wallet-settings-create-token_supply-block, .wallet-settings-create-token_divisible-block {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: calc(var(--s-basic-spacing) * 2);
  cursor: pointer;
}
.wallet-settings-create-token_supply-block > span, .wallet-settings-create-token_divisible-block > span {
  margin-left: calc(var(--s-basic-spacing) * 1.5);
  font-size: var(--s-font-size-medium);
  font-weight: 300;
  letter-spacing: var(--s-letter-spacing-small);
  line-height: var(--s-line-height-medium);
}
.wallet-settings-create-token_supply-block, .wallet-settings-create-token_divisible-block {
  padding: 0 calc(var(--s-basic-spacing) * 1.5);
}
.s-textarea {
  margin-bottom: calc(var(--s-basic-spacing) * 2);
}
.el-textarea {
  height: 54px;
}
.el-textarea__inner {
  resize: none;
  scrollbar-width: none; /* Firefox - not customizable */
}
.el-textarea__inner:hover::-webkit-scrollbar {
  width: 4px;
}
.el-textarea__inner:hover::-webkit-scrollbar-thumb {
  background-color: var(--s-color-base-content-tertiary);
  border-radius: 6px;
}
.el-textarea__inner::-webkit-scrollbar {
  width: 4px;
}
.el-textarea__inner::-webkit-scrollbar-track {
  margin-bottom: calc(var(--s-size-small) * 0.25);
}
.preview-image-create-nft {
  margin: calc(var(--s-basic-spacing) * 2) 0;
  height: 200px;
}
.preview-image-create-nft .placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.preview-image-create-nft__icon {
  color: var(--s-color-base-content-tertiary);
  margin-bottom: calc(var(--s-size-small) / 2);
}
.preview-image-create-nft__icon.icon--error {
  color: var(--s-color-theme-accent);
}
.preview-image-create-nft__btn {
  margin-top: calc(var(--s-size-small) / 2);
  height: 32px !important;
}
.preview-image-create-nft__placeholder {
  letter-spacing: var(--s-letter-spacing-small);
  color: var(--s-color-base-content-primary);
  font-size: calc(var(--s-size-small) / 2);
  text-align: center;
  padding: 0 50px;
}
.preview-image-create-nft .image {
  margin: 0 auto;
  height: 176px;
}
.preview-image-create-nft__content {
  height: 176px;
  width: 176px;
  object-fit: cover;
  border-radius: calc(var(--s-border-radius-mini) * 0.75);
}
.delimiter {
  background-color: var(--s-color-base-border-secondary);
  margin-bottom: calc(var(--s-size-small) / 2);
  height: 1px;
}`,map:void 0,media:void 0}))},WC,"data-v-0970a532",!1,void 0,!1,zt$3);let XC=class extends Mixins(Vd,ld,Od){constructor(){super(...arguments);T0(this,"XOR",XOR_1.symbol);T0(this,"Step",en$1);T0(this,"decimals",build$6.FPNumber.DEFAULT_PRECISION);T0(this,"delimiters",build$6.FPNumber.DELIMITERS_CONFIG);T0(this,"maxTotalSupply",MaxTotalSupply_1);T0(this,"tokenSymbolMask","AAAAAAA");T0(this,"tokenNameMask",{mask:"Z*",tokens:{Z:{pattern:/[0-9a-zA-Z ]/}}});T0(this,"step");T0(this,"navigate");T0(this,"isConfirmTxDisabled");T0(this,"tokenSymbol","");T0(this,"tokenName","");T0(this,"tokenSupply","");T0(this,"extensibleSupply",!1);T0(this,"showFee",!0)}get fee(){return this.getFPNumberFromCodec(this.networkFees.RegisterAsset)}get formattedFee(){return this.fee.toLocaleString()}get isCreateDisabled(){return!(this.tokenSymbol&&this.tokenName.trim()&&+this.tokenSupply)}get formattedTokenSupply(){return this.formatStringValue(this.tokenSupply,this.decimals)}get hasEnoughXor(){const ou=build$6.api.assets.accountAssets.find(e0=>e0.address===XOR_1.address);if(!ou||!ou.balance||!+ou.balance.transferable)return!1;const vu=this.getFPNumberFromCodec(ou.balance.transferable,ou.decimals);return build$6.FPNumber.gte(vu,this.fee)}async registerAsset(){return build$6.api.assets.register(this.tokenSymbol,this.tokenName.trim(),this.tokenSupply,this.extensibleSupply)}async onCreate(){if(this.tokenSymbol.length&&this.tokenSupply.length&&this.tokenName.length){if(this.tokenSupply=this.getCorrectSupply(this.tokenSupply,this.decimals),this.$emit("showTabs"),this.allowFeePopup&&this.hasEnoughXor&&!this.isXorSufficientForNextTx({type:build$6.Operation.RegisterAsset}))return this.$emit("showHeader"),this.showFee=!1,void this.$emit("stepChange",en$1.Warn);this.isConfirmTxDisabled?await this.onConfirm():(this.showFee=!0,this.$emit("stepChange",en$1.ConfirmSimpleToken))}}async onConfirm(){await this.withNotifications(async()=>{if(!this.hasEnoughXor)throw new Error("insufficientBalanceText");await this.