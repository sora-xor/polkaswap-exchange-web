
ˆ€.vault-details-container[data-v-53f0d5a0]{display:flex;gap:16px}.vault-details-container.empty[data-v-53f0d5a0]{height:calc(100dvh - 96px)}.vault-details-container .details-card[data-v-53f0d5a0]{box-shadow:var(--s-shadow-element-pressed);margin-bottom:24px}.vault-details-main[data-v-53f0d5a0]{flex:1}.vault-details-main .close-vault-button[data-v-53f0d5a0]{color:var(--s-color-theme-accent);margin-bottom:24px;text-transform:none}.vault-title[data-v-53f0d5a0]{align-items:center}.vault-title__container[data-v-53f0d5a0]{align-items:flex-start;flex:1;margin:0 8px}.vault-label[data-v-53f0d5a0]{color:var(--s-color-base-content-secondary)}.position-info__details[data-v-53f0d5a0],.vault-collateral__details[data-v-53f0d5a0],.vault-debt__details[data-v-53f0d5a0]{flex-wrap:wrap;justify-content:space-between;margin-bottom:16px}.position-info__item[data-v-53f0d5a0],.vault-collateral__item[data-v-53f0d5a0],.vault-debt__item[data-v-53f0d5a0]{flex:1 1 50%;margin-top:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.position-info__item[data-v-53f0d5a0]>*,.vault-collateral__item[data-v-53f0d5a0]>*,.vault-debt__item[data-v-53f0d5a0]>*{line-height:var(--s-line-height-big)}.vault-returned[data-v-53f0d5a0]{align-items:center}.vault-returned[data-v-53f0d5a0]>*{line-height:var(--s-line-height-big)}.position-info__details[data-v-53f0d5a0]{margin-bottom:0}.ltv__value[data-v-53f0d5a0]{align-items:center;font-size:var(--s-font-size-big);margin-bottom:16px}.ltv__badge[data-v-53f0d5a0]{margin-left:8px}.ltv__legend[data-v-53f0d5a0]{flex-wrap:wrap;margin-top:16px}.ltv__legend-item[data-v-53f0d5a0]{align-items:baseline;display:flex;flex:1 1 50%;line-height:var(--s-line-height-big)}.ltv__legend-icon[data-v-53f0d5a0]{border-radius:50%;height:12px;margin-right:2px;width:12px}.ltv__legend-icon.success[data-v-53f0d5a0]{background-color:var(--s-color-status-success)}.ltv__legend-icon.warning[data-v-53f0d5a0]{background-color:var(--s-color-status-warning)}.ltv__legend-icon.error[data-v-