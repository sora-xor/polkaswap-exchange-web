  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  padding-top: calc(var(--s-basic-spacing) * 0.5);
  padding-bottom: calc(var(--s-basic-spacing) * 0.5);
  text-align: center;
  font-size: var(--s-font-size-mini);
}
.wallet-assets-headline__content--no-fiat > span[data-v-b06803ba] {
  position: relative;
  left: 100%;
  transform: translateX(-100%);
}
.wallet-assets-headline__divider[data-v-b06803ba] {
  margin: 0;
}
.total-fiat-values[data-v-b06803ba] {
  display: flex;
  align-items: baseline;
}
.total-fiat-values__title[data-v-b06803ba] {
  text-transform: uppercase;
  padding-right: calc(var(--s-basic-spacing) / 4);
  white-space: nowrap;
  font-weight: 300;
  letter-spacing: var(--s-letter-spacing-small);
}
.total-fiat-values .formatted-amount--fiat-value[data-v-b06803ba] {
  display: block;
  font-size: var(--s-font-size-small);
  font-weight: 500;
}`,map:void 0,media:void 0}),Ya("data-v-b06803ba_1",{source:`.wallet-assets-filter.el-popover {
  background-color: var(--s-color-utility-body);
  border-radius: 16px;
  color: var(--s-color-base-content-primary);
  border: none;
  padding: 16px 16px 0 16px;
  font-size: var(--s-font-size-small);
}
.wallet-assets-filter.el-popover .el-radio {
  font-weight: 300;
  margin-right: 20px;
}
.wallet-assets-filter.el-popover .el-radio .el-radio__label {
  font-size: var(--s-font-size-small);
}
.wallet-assets-filter__switch {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: calc(var(--s-basic-spacing) * 2);
  cursor: pointer;
}
.wallet-assets-filter__switch > span {
  margin-left: calc(var(--s-basic-spacing) * 1.5);
  font-size: var(--s-font-size-small);
  font-weight: 300;
  letter-spacing: var(--s-letter-spacing-small);
  line-height: var(--s-line-height-medium);
}
.wallet-assets-filter__switch {
  padding-top: 0;
}
.wallet-assets-filter__switch .s-switch.neumorphic .el-switch__input:disabled + .el-switch__core {
  background-color: var(--s-color-base-border-secondary);
}
.wallet-assets-filter__text {
  margin-bottom: 4px;
}
.wallet-assets-filter__divider {
  margin: 16px 0;
}
.wallet-assets-filter__button {
  background-color: var(--s-color-base-border-primary);
  padding: 3px 8px;
  border-radius: 10px;
  transition: 0s background-color;
  color: var(--s-color-base-content-primary);
  font-weight: 300;
}
.wallet-assets-filter__button-option {
  color: var(--s-color-theme-accent);
}
.wallet-assets-filter__button .wallet-assets-filter__button-icon {
  color: var(--s-color-base-content-tertiary);
  margin-left: 6px;
}
.wallet-assets-filter__button:hover {
  cursor: pointer;
  background-color: var(--s-color-base-border-secondary);
