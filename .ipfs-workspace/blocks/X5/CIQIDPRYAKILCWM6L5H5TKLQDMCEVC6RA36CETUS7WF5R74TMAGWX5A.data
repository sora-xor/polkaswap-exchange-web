  border-bottom-left-radius: 4px;
}
.mask-box-angle.bottom-right[data-v-257aa454] {
  bottom: 0;
  right: 0;
  border-right: 2px solid var(--s-color-theme-accent);
  border-bottom: 2px solid var(--s-color-theme-accent);
  border-bottom-right-radius: 4px;
}
