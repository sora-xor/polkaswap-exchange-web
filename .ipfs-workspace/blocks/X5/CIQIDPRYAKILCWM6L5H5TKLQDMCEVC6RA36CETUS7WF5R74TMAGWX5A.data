  color: var(--s-color-base-content-secondary) !important;
}
.threshold-amount input[type=number]::-webkit-inner-spin-button,
.threshold-amount input[type=number]::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
