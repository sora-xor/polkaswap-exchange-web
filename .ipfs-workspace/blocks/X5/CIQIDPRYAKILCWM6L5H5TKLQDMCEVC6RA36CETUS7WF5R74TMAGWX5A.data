  opacity: 0.5;
}
.sortable-drag .wallet-assets-divider {
  display: none;
}
.wallet-assets-item {
  position: relative;
  background-color: var(--s-color-utility-surface);
  border-radius: calc(var(--s-border-radius-mini) / 2);
}
.wallet-assets-dashes {
  position: absolute;
  top: 25%;
  height: 50%;
  width: 10px;
  cursor: grab;
  z-index: 1;
}
.wallet-assets-three-dash {
  width: 10px;
  height: 2px;
  top: 50%;
  position: absolute;
  background-color: var(--s-color-base-content-tertiary);
  border-radius: 1px;
}
.wallet-assets-three-dash::before {
  content: "";
  width: 10px;
  height: 2px;
  top: 5px;
  position: absolute;
  background-color: var(--s-color-base-content-tertiary);
  border-radius: 1px;
}
.wallet-assets-three-dash::after {
  content: "";
  width: 10px;
  height: 2px;
  top: calc(5px * -1);
  position: absolute;
  background-color: var(--s-color-base-content-tertiary);
  border-radius: 1px;
}
.wallet-assets-list.asset-list {
  margin-left: calc(calc(var(--s-basic-spacing) * 3) * -1);
  margin-right: calc(calc(var(--s-basic-spacing) * 3) * -1);
}
.wallet-assets-list.asset-list .asset-list-inner {
  padding-left: calc(var(--s-basic-spacing) * 3);
  padding-right: calc(var(--s-basic-spacing) * 3);
}
.wallet-assets-scrollbar.el-scrollbar {
  margin-left: calc(calc(var(--s-basic-spacing) * 3) * -1);
  margin-right: calc(calc(var(--s-basic-spacing) * 3) * -1);
}
.wallet-assets-scrollbar.el-scrollbar .el-scrollbar__wrap {
  overflow-x: hidden;
  margin-bottom: 0px !important;
  height: calc(var(--s-asset-item-height--fiat) * 3 + 32px);
}
.wallet-assets-scrollbar.el-scrollbar .el-scrollbar__wrap,
.wallet-assets-scrollbar.el-scrollbar .el-scrollbar__view {
  display: flex;
  flex: 1;
  flex-flow: column nowrap;
}
.wallet-assets-scrollbar.el-scrollbar .el-scrollbar__view {
  padding-left: calc(var(--s-basic-spacing) * 3);
  padding-right: calc(var(--s-basic-spacing) * 3);
}
.wallet-assets-scrollbar.el-scrollbar .el-scrollbar__bar.is-vertical {
  right: 2px;
}
.wallet-assets--empty {
  margin-top: calc(var(--s-basic-spacing) * 2);
  text-align: center;
  color: var(--s-color-base-content-secondary);
  font-size: var(--s-font-size-mini);
  font-weight: 300;
  line-height: var(--s-line-height-medium);
  letter-spacing: var(--s-letter-spacing-small);
}
.wallet-assets .asset .logo {
  margin-left: 20px;
}
.wallet-assets .asset .formatted-amount {
  display: block;
  width: 100%;
  line-height: var(--s-line-height-reset);
}
.wallet-assets .asset .formatted-amount__container {
  justify-content: flex-start;
  text-align: left;
}
.wallet-assets .asset .formatted-amount--fiat-value {
  margin-top: calc(var(--s-basic-spacing) / 2);
}
.wallet-assets .asset-value {
  height: calc(var(--s-basic-spacing) * 2);
  font-size: var(--s-font-size-medium);
  font-weight: 800;
  letter-spacing: var(--s-letter-spacing-mini);
  line-height: var(--s-line-height-reset);
}
.wallet-assets .asset-value-locked {
  margin-left: calc(var(--s-basic-spacing) * 0.5);
}
.wallet-assets .asset-value .formatted-amount__decimal {
  font-weight: 600;
}
.wallet-assets .asset-value {
  position: relative;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.wallet-assets .asset-value.formatted-amount--value-wider:active, .wallet-assets .asset-value.formatted-amount--value-wider:hover {
  overflow: visible;
}
.wallet-assets .asset-value.formatted-amount--value-wider:active > span, .wallet-assets .asset-value.formatted-amount--value-wider:hover > span {
  display: inline-table;
  position: absolute;
  z-index: 1;
  white-space: break-spaces;
  background: var(--s-color-utility-body);
  border: 1px solid var(--s-color-base-border-secondary);
  border-radius: 8px;
  padding: 4px 8px;
  top: -5px;
  left: -9px;
}
.wallet-assets .asset-info {
  margin-top: calc(var(--s-basic-spacing) / 2);
  color: var(--s-color-base-content-primary);
  line-height: var(--s-line-height-reset);
}
.wallet-assets__button.el-button.neumorphic.s-action:not(.s-primary).s-alternative:disabled, .wallet-assets__button.el-button.neumorphic.s-action:not(.s-primary).s-alternative:disabled > span > i {
  color: var(--s-color-base-background);
}
.wallet-assets__button.el-button.neumorphic.s-action:not(.s-primary).s-alternative:not(:disabled):hover, .wallet-assets__button.el-button.neumorphic.s-action:not(.s-primary).s-alternative:not(:disabled):focus {
  color: var(--s-color-theme-accent-hover);
}
.wallet-assets__button.el-button.neumorphic.s-action:not(.s-primary).s-alternative:not(:disabled):active, .wallet-assets__button.el-button.neumorphic.s-action:not(.s-primary).s-alternative:not(:disabled).s-pressed {
  color: var(--s-color-theme-accent-pressed);
}`,map:void 0,media:void 0}),Ya("data-v-3ed1b70a_1",{source:`.wallet-assets[data-v-3ed1b70a] {
