  text-transform: uppercase;
  margin-right: var(--s-basic-spacing);
  font-weight: 300;
  white-space: nowrap;
}
.asset-details-balance-info .balance-label--total[data-v-2d5f49d8] {
  font-weight: 600;
}
.asset-details-actions[data-v-2d5f49d8] {
