  margin-left: var(--s-basic-spacing);
}
.transaction .info-line-container[data-v-a08f52ae] {
  margin-bottom: calc(var(--s-basic-spacing) * 2);
}
.transaction .formatted-amount__divider[data-v-a08f52ae] {
  margin-right: calc(var(--s-basic-spacing) / 4);
  margin-left: calc(var(--s-basic-spacing) / 4);
}
.transaction + .transaction[data-v-a08f52ae] {
  margin-top: calc(var(--s-basic-spacing) * 3);
}
.transaction-network[data-v-a08f52ae] {
  text-align: center;
  margin-bottom: var(--s-basic-spacing);
}
.history[data-v-a08f52ae] {
  align-items: center;
}
.history-info[data-v-a08f52ae] {
  flex: 1;
  flex-direction: column;
  font-size: var(--s-font-size-mini);
}
.history-info_date[data-v-a08f52ae] {
  color: var(--s-color-base-content-tertiary);
}
.history[data-v-a08f52ae]:not(:last-child) {
  margin-bottom: var(--s-basic-spacing);
}
.sign-btn[data-v-a08f52ae] {
  margin-top: 16px;
  width: 100%;
}
.amount-of-signatures[data-v-a08f52ae] {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 12px;
  margin-top: 24px;
}
.amount-of-signatures .already-signed[data-v-a08f52ae] {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-weight: 800;
  color: var(--s-color-base-content-secondary);
}
.amount-of-signatures .already-signed span[data-v-a08f52ae] {
  color: var(--s-color-status-success);
}
.amount-of-signatures .progress-bar-container[data-v-a08f52ae] {
  background-color: #f4f0f1;
  height: 6px;
  border-radius: 4px;
  overflow: hidden;
}
.amount-of-signatures .progress-bar-container .progress-bar[data-v-a08f52ae] {
  background-color: var(--s-color-status-success);
  height: 100%;
  border-radius: 4px;
}
.xor-min-amount[data-v-a08f52ae] {
  margin-top: 8px;
}
.xor-min-amount span[data-v-a08f52ae] {
  margin-left: 60px;
