}
.wallet-send .asset-name[data-v-5324f933] {
  font-size: var(--s-icon-font-size-small);
  line-height: var(--s-line-height-reset);
}
.wallet-send .asset-info[data-v-5324f933] {
  display: flex;
  align-items: baseline;
}
.wallet-send .asset-info .formatted-amount--fiat-value[data-v-5324f933] {
  margin-right: calc(var(--s-basic-spacing) / 2);
  font-weight: 600;
}
.wallet-send .asset-highlight[data-v-5324f933] {
  margin-left: auto;
