}
.wallet-send .asset-balance[data-v-5324f933] {
  margin-left: auto;
}
.wallet-send .asset-balance-title[data-v-5324f933] {
  color: var(--s-color-base-content-tertiary);
  font-size: var(--s-font-size-mini);
}
