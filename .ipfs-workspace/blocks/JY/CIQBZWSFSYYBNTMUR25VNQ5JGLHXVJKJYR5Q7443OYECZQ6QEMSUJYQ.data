me:"Пожалуйста, введите название ноды",incorrectAddress:"Неверный адрес",incorrectProtocol:"Адрес должен начинаться с ws:// или wss://"},nodeTitle:"{chain} на базе {name}",select:"Выберите",title:"Выбор сетевого узла",updateNode:"Обновить узел"},Vt="Выбрать узел",Xt={search:{networkLabelEthereum:"{network} зеркальные токены сети",networkLabelSora:"{Sora} токены сети",placeholder:"Фильтр по ID актива, имени или символу тикера"},title:"Выбрать токен"},qt={assets:{title:"Активы"},custom:{alreadyAttached:"Этот токен уже добавлен",notFound:"Токен не найден",search:"Введите ID актива",text:"ПЕРСОНАЛИЗИРОВАННЫЕ ТОКЕНЫ",title:"Кастомный"},emptyListMessage:"Нет результатов",searchPlaceholder:"Фильтр по ID актива, имени или символу тикера",title:"Выберите токен"},It="Отправить",Wt="Отправить",Ht="Настройки",Ut="Подписать и получить",Kt={github:"GitHub",medium:"Средний",reddit:"Reddit",telegram:"Telegram",twitter:"Twitter",wiki:"{Sora} Вики"},Jt={actions:{claim:"Получите награды",confirm:"Подтвердить стейкинг",more:"Застейкать ещё",remove:"Удалить стейкинг",withdraw:"Вывод"},allWithdrawsDialog:{information:"После анстейкинга токенов наступает обязательный 7-дневный период анстейкинга. По истечении этого периода ваши токены не будут автоматически возвращены на ваш кошелек. Вы должны завершить процесс, выведя свои токены вручную.",title:"Анстейкинг активность"},claimRewardsDialog:{checkRewards:"Проверьте награды за эпоху и валидаторов",rewardsDestination:"Адрес для получения наград",title:"Получите награды"},dropdownMenu:{controllerAccount:"Аккаунт контроллера"},info:{minimumStake:"Минимальный стейк",nominators:"Номинаторы",rewarded:"Заработано",rewardToken:"Наградной токен",selectedValidators:"Выбранные валидаторы",stakingBalance:"Баланс стейкинга",totalLiquidityStaked:"Общая ликвидность в стейкинге",unstaking:"В процессе вывода",unstakingPeriod:"Период анстейкинга",validators:"Валидаторы"},newStake:{title:"Начать стейкинг"},overview:{description:"Застейкайте токены {XOR} в сети {Sora} в качестве номинатора, чтобы подтверждать транзакции, и получать вознаграждение в токенах {VAL}.",title:"{Sora} Стейкинг"},pendingRewardsDialog:{information:"Валидаторы выплачивают вознаграждения каждые 2-5 дней. Однако вы можете выплачивать их самостоятельно, особенно если срок действия вознаграждений близок, но при этом вы заплатите комиссию.",noPendingRewards:"Ожидаемых наград нет",noSelectedRewards:"Выберите награды",payout:"Выплатить",title:"Ожидаемые награды"},selectedValidators:"{count} ( {Max} {max} )",selectValidatorsMode:{confirm:{manual:"Я сам выберу валидаторов",suggested:"Застейкать с предложенными"},criteria:{0:"Самый прибыльный",1:"Не превышен лимит номинаторов",2:"Наличие ончейн-идентификации",3:"Нет штрафов",4:"Ограничение 2 валидаторов на одну личность"},description:"Алгоритм сети {Sora} отобрал список рекомендуемых валидаторов на основе критериев:",title:"Стейкинг с валидаторами, предложенными алгоритмом"},stakeDialog:{toRemove:"Удалить",toStake:"Застейкать"},validators:{alreadyNominated:"Выбранные валидаторы уже номинированы",change:"Сменить валидаторов",next:"Далее",recommended:"Рекомендуемые валидаторы",save:"Сохранить изменения",select:"Выберите валидаторов",selected:"{selected} / {total} выбрано",tooManyValidators:"Выбрано слишком много валидаторов ({Max} {max})"},validatorsAttentionDialog:{confirm:"Да, я понимаю риск",description:{0:"Предложения валидаторов с помощью алгоритма не являются финансовой консультацией или советом. Стейкинг — это деятельность с высоким риском, и предложенные с помощью алгоритма валидаторы не обязательно снижают этот риск.",1:"Валидатор, предложенный алгоритмом, все равно может быть оштрафован. Валидатор, предложенный алгоритмом, также может изменить свои параметры (например, размер комиссии и т. д.) в любое время после того, как он был предложен и/или выбран.",2:"Вы можете потерять токены или награды по тем или иным причинам. Стейкайте токены и используйте предложенных валидаторов только по своему усмотрению, после проведения комплексной проверки и тщательного рассмотрения связанных с этим рисков."},title:"Внимание"},validatorsDialog:{tabs:{all:"Все валидаторы",user:"Ваши валидаторы"},title:{edit:"Редактировать моих валидаторов"}},validatorsFilterDialog:{filters:{hasIdentity:{description:"К учетной записи подключен хотя бы один контакт с идентификацией.",name:"Идентификация в сети"},notOversubscribed:{description:"Учетная запись в пределах лимита распределения, позволяет избежать штрафов за превышение подписки на стейкинг {Polkadot}.",name:"Не превышено количество подписчиков"},notSlashed:{description:"Не было никаких штрафов или сокращения средств стейкинга из-за неправомерного поведения или нарушений протокола.",name:"Нет штрафов"},twoValidatorsPerIdentity:{description:"Не более двух валидаторов на одну личность для обеспечения децентрализации и предотвращения захвата власти.",name:"Ограничение 2 валидаторов на одну личность"}},reset:"Сбросить все",save:"Сохранить фильтр",title:"Фильтры"},validatorsList:{commission:"Комиссия",commissionTooltip:"Комиссия — это плата, взимаемая валидаторами за свои услуги в процессе размещения стейкинга. Эта комиссия, выраженная в процентах, вычитается из вознаграждений за стейкинг, полученных номинаторами перед распределением. Важно отметить, что валидаторы могут корректировать стейкинг комиссии в любое время.",name:"Имя",noNominatedValidators:"У вас нет номинированных валидаторов",noValidators:"Нет валидаторов, удовлетворяющих указанному фильтру",return:"Возврат",search:"Поиск..."},withdraw:{beingWithdrawn:"Будет выведено",countdownLeft:"осталось",nextWithdrawal:"Следующий вывод",seeAll:"Посмотреть все",withdrawable:"Доступно для вывода"},withdrawDialog:{showAllWithdraws:"Показать все выводы",title:"Вывод анстейкнутых средств"}},Yt="Шаг",Gt="Успешно",jt={confirmSwap:"Подтвердить обмен",errorFetching:"Ошибка при получении данных",insufficientAmount:"Недостаточный {tokenSymbol} баланс",insufficientLiquidity:"Недостаточная ликвидность",liquidityProviderFee:"Комиссия поставщика ликвидности",liquidityProviderFeeTooltip:"Часть каждой сделки ({liquidityProviderFee}%) направляется поставщикам ликвидности в качестве вознаграждения протокола.",maxSold:"Максимум продано",minReceived:"Минимум получено",minReceivedTooltip:"Ваша транзакция будет отменена, если произойдет значительное неблагоприятное изменение цены до ее подтверждения.",priceImpact:"Влияние на цену",priceImpactTooltip:"Разница между рыночной ценой и оценочной ценой из-за размера сделки.",rewardsForSwap:"Стратегические вознаграждения PSWAP",route:"Маршрут",slippageTolerance:"Допустимое проскальзывание",swapOutputMessage:"Вывод оценён. Вы получите как минимум {transactionValue} или транзакция будет отменена."},zt="Обмен",Qt={assetId:"ID актива"},_t={accounts:"Аккаунты — это цифровые адреса, на которых хранятся активы пользователя в сети. Каждая учетная запись связана с уникальным общедоступным адресом и закрытым ключом, который позволяет пользователю получать доступ к своим активам и управлять ими.",bridgeTransactions:"Мост из {from} в {to} относится к процессу передачи активов между сетями {from} и {to} с использованием моста. Мост обеспечивает совместимость двух сетей, позволяя пользователям беспрепятственно перемещать активы между ними.",fees:"Комиссии в блокчейне {Sora} относятся к сборам, взимаемым за выполнение транзакций в сети. Эти сборы оплачиваются в XOR, собственной криптовалюте сети {Sora} . Размер комиссии определяется сложностью и размером выполняемой транзакции.",roi:"{ROI} означает рентабельность инвестиций. Она рассчитывается путем деления прибыли, полученной от инвестиции, на стоимость этой инвестиции в процентном эквиваленте.",supply:"Предложение токенов относится к общему количеству токенов, которые были созданы и находятся в обращении в сети. Предложение токенов может колебаться в зависимости от количества токенов, размещаемых, сжигаемых или передаваемых по сети.",transactions:"Транзакции относятся к процессу отправки или получения цифровых активов в сети, включая операции с ликвидностью, а также обмены.",tvl:"{TVL} означает «Общая заблокированная стоимость». Она представляет токены, заблокированные в пулах, в долларовом эквиваленте.",velocity:"Скорость токена — это среднее количество раз, когда токен меняет учетную запись в течение периода (месяца). Он указывает на уровень торговой активности и ликвидности.",volume:"Объем относится к общему количеству активов, которые были проданы или обменены в сети за определенный период времени. Объем является важным показателем для измерения ликвидности и общей активности сети."},$t={amount:"@:amountText",amount2:"@:amountText 2",blockId:"ID Блока",comment:"Комментарий",copy:"Копировать {value}",fee:"Комиссия за транзакцию",from:"От",history:{confirmed:"Транзакция подтверждена",created:"Транзакция для {amount} {symbol} была создана.",submitted:"Транзакция отправлена с комиссией в размере {fee} {symbol}"},price:"Цена",referral:"Реферал",referrer:"Реферер",side:"Сторона",startTime:"Дата",status:"Статус",statuses:{complete:"Выполнено",failed:"Транзакция не удалась",pending:"В обработке..."},title:"Детали транзакции",to:"Кому",total:"Всего",txId:"ID транзакции",viewIn:"Смотреть в {explorer}"},Zt="Детали транзакции",eo="Транзакция отправлена",to="транзакцию | транзакции",oo={from:"Из",to:"На"},ao="Неизвестный актив",so="ОШИБКА Что-то пошло не так...",no={WalletAssets:"Активы",WalletHistory:"Активность"},ro={addressError:"Вы не можете отправлять токены в ту же учетную запись, к которой вы в настоящее время подключены.",addressWarning:"Токены будут отправлены на адрес {Sora}, указанный ниже. Убедитесь, что получатель может получить доступ к сети {Sora} для использования токенов:",badAddress:"Неверный адрес",balance:"Баланс",confirmTitle:"Подтвердить транзакцию",enableVesting:"Включить вестинг токенов",enterAddress:"Введите адрес",enterAmount:"Введите сумму",enterVestingPercentage:"Введите процент вестинга",errorAddress:"Неверный адрес. Пожалуйста, пе