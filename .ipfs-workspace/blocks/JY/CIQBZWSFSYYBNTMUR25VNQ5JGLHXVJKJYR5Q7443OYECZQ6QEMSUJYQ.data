ствия.',firstSecondPoolTokens:"{first}-{second} Токены пула",pricePool:"Цены и доля пула",shareOfPool:"Доля пула",supply:"Добавить",yourPosition:"Ваша позиция"},te={confirmTokenTitleCommon:"Создать токен",confirmTokenTitleNFT:"Создать NFT",CreateSimpleToken:"Токен",divisible:{desc:"Способность NFT делиться на дробные части. Предоставление ликвидности работает только с делимыми активами",placeholder:"Делимый"},enterName:"Введите название токена",enterSupply:"Введите количество токенов",enterSymbol:"Введите символ токена",enterTokenDescription:"Введите описание",error:"Не удалось создать {symbol} токен",extensibleSupply:{desc:"Возможность выпустить больше токенов.",placeholder:"Увеличиваемая эмиссия"},nft:{description:{placeholder:"Описание"},image:{placeholderBadSource:"Файл не удалось обработать",placeholderBadSourceAddition:"или оно ещё не загружено в IPFS",placeholderFileLimit:"Размер файла превышает ограничение в {value}мб.",placeholderNoImage:"Загрузите файл, введя ссылку или выбрав из локального хранилища."},link:{copyLink:"Копировать ссылку",placeholder:"Ссылка IPFS",tooltip:"IPFS — это распределенная система для хранения файлов и доступа к ним, позволяющая получать доступ к файлам из многих мест, которые не управляются одной организацией."},source:{label:"Источник",limit:"Выбрать другой файл",value:"Локальные файлы"},supply:{desc:"Количество NFT, которое вы собираетесь получить.",placeholder:"Количество токенов",quantity:"Количество"}},provideContent:"Предоставить контент",success:{desc:"Создать {symbol} токен ",title:"Транзакция отправлена"},titleCommon:"Создать",tokenName:{desc:"Это название токена. Для выбора можно использовать от 1 до 33 символов.",placeholder:"Название токена"},tokenSupply:{desc:"Вы получите эти токены при создании.",placeholder:"Количество токенов"},tokenSymbol:{desc:"Это идентификатор токена. Для выбора можно использовать от 1 до 7 символов.",placeholder:"Символ токена"}},oe="Создать токен",ae="Создать NFT",se={currency:"Валюта",searchPlaceholder:"Поиск по названию или символу валюты"},ne="Настроить страницу",re="Темный",ie={actions:{add:"Застейкать ещё",claim:"Получить награды",remove:"Удалить стейк",start:"Начать стейкинг"},amountAdd:"Сумма стейкинга",amountRemove:"Сумма для удаления",calculator:"Калькулятор",info:{earned:"{symbol} заработано",fee:"Комиссия",feeTooltip:"Комиссия за депозит применяется к вашей сумме стейка",owned:"@:balanceText {symbol}",poolShare:"Ваша доля пула застейкана",poolShareWillBe:"Ваша доля пула будет",rewardToken:"Токен вознаграждения",stake:"Ваш стейк {symbol}",stakeWillBe:"Ваш стейк {symbol} будет",totalLiquidityLocked:"Ликвидность заблокирована"},poweredBy:"Работает на Demeter Farming",results:"Результаты",rewards:"{symbol} награды",staking:{active:"Стейкинг активен",inactive:"Начните стейкинг, чтобы заработать дополнительные награды",stopped:"Стейкинг остановлен"}},le={accountMnemonic:{placeholder:"Мнемоническая фраза"},accountName:{desc:"Это имя вашего аккаунта. Оно будет видно только Вам в {Polkaswap}.",placeholder:"Имя аккаунта"},addAccount:"Добавить аккаунт",assetsAtRiskText:"Активы под угрозой!",button:{createAccount:"Создать учетную запись",importAccount:"Импорт аккаунта",next:"Следующий шаг",skip:"Пропустить"},confirmPassword:{placeholder:"Подтвердить Пароль"},confirmSeedText:"Подтвердите парольную фразу, выбрав слова в правильном порядке.",deleteAccountText:"Аккаунт не может быть восстановлен без исходной фразы, файла .json или если он хранится в каком-либо расширении. Вы выйдете из системы.",dialog:{confirmButton:"Подписать транзакцию",confirmTitle:"Подтвердите паролем"},errorMessages:{alreadyImported:"Аккаунт уже импортирован {address}",jsonFields:"JSON-файл не содержит обязательных полей",mnemonic:"Указана недопустимая мнемоника bip39",mnemonicLength:"Мнемоника должна содержать {number} слов",password:"Пароль не совпадает",passwords:"Пароли не совпадают"},errorMnemonicText:"Неправильный порядок парольной фразы",exportJsonText:"Вы всегда сможете восстановить свою учетную запись, импортировав этот файл {JSON}. Не делитесь им ни с кем! Храните его в безопасном месте, желательно в зашифрованном виде.",exportOptionText:"Экспорт файла {JSON} для восстановления аккаунта",exportTutorialsText:"Инструкции по экспорту",heading:{accountDetailsTitle:"Детали учетной записи",confirmSeedTitle:"Подтвердите парольную фразу",importTitle:"Импорт аккаунта",seedPhraseTitle:"Парольная фраза"},importSteps:{exportAccount:"Экспортируйте файл {JSON}",selectAccount:"Выберите учетную запись, которую вы хотите экспортировать",selectWallet:"Откройте кошелек с Вашим существующим аккаунтом(ами)"},password:{desc:"Убедитесь, что Вы используете надежный уникальный пароль для надлежащей защиты (минимум 8 символов).",placeholder:"Пароль"},seedAdviceAdditionText:"Если кто-то спросит у Вас парольную фразу, скорее всего, он попытается Вас обмануть и украсть Ваши активы!",seedAdviceAdditionTitle:"Никогда и никому не сообщайте Вашу парольную фразу!",seedAdviceText:"Парольная фраза из 12 слов — это закрытый ключ для восстановления доступа к вашей учетной записи {Sora} в случае, если вы потеряете доступ к своей учетной записи {wallet}. Храните его в безопасном месте в том порядке, в котором он указан выше.",welcome:{createAccount:"Завести аккаунт",header:"Добро пожаловать в {AppName}!",headline:"Давайте настроим вашу учетную запись",importAccount:"Импорт аккаунта",text:"Создайте свою учетную запись {Sora} Network или войдите в старые, используя мнемоническую фразу или импорт .json. Это позволяет безопасно подписывать транзакции и управлять активами в сети {Sora}."}},ce={marketAlgorithm:"@.upper:marketAlgorithmText",marketAlgorithms:{SMART:"{smartAlgorithm} маршрутизация ликвидности обеспечивает лучшую цену для любой транзакции, комбинируя только лучшие ценовые варианты со всех доступных рынков. Когда доступно, кривая связывания токенов ({tbcAlgorithm}) будет использоваться для обеспечения ликвидности, если цена актива будет более привлекательной, чем из других источников, на которых используется пул {xycAlgorithm}.",TBC:"{tbcAlgorithm} — покупка только из кривой связывания токенов (Token Bonding Curve) (Первичный Рынок). Есть вероятность того, что цена может стать невыгодной по сравнению с {xycAlgorithm} пулом (Вторичным Рынком), но ценность полученных вознаграждений со временем может оказаться гораздо более выгодной.",XYK:"{xycAlgorithm} — покупка только из пула XYK (вторичный рынок). Традиционный пул обмена XYK."},marketAlgorithmTooltip:{main:" - возможность выбора между первичным рынком (TBC), вторичным рынком (XYK) или комбинированным интеллектуальным алгоритмом для гарантированно лучшей цены для любой данной транзакции."},slippageTolerance:"Допустимое проскальзывание",slippageToleranceHint:"Ваша транзакция будет отменена, если цена изменится в неблагоприятную сторону более чем на этот процент.",slippageToleranceValidation:{error:"Введите допустимый процент проскальзывания",frontrun:"Ваша транзакция может быть осуществлена заранее",warning:"Ваша транзакция может не пройти"},title:"Настройки"},de="{disclaimerPrefix} этот веб-сайт поддерживается {Sora} сообществом. Прежде чем продолжить использование этого веб-сайта, просмотрите {polkaswapFaqLink} и документацию, которая включает подробное объяснение принципов работы {AppName}, а также {memorandumLink} и {privacyLink}. Эти документы важны для обеспечения безопасности и положительного пользовательского опыта. Используя {AppName}, вы подтверждаете, что прочитали и поняли эти документы. Вы также соглашаетесь со следующим: 1) Вы несете исключительную ответственность за соблюдение всех законов, которые могут применяться к использованию вами {AppName} в Вашей правовой юрисдикции; 2) Вы понимаете, что текущая версия {AppName} является альфа-версией: она не была полностью протестирована, и некоторые функции могут работать не так, как задумано; и 3) Вы понимаете и добровольно принимаете риски, связанные с использованием {AppName}, включая, помимо прочего, риск потери токенов. Еще раз подчеркиваем - пожалуйста, не используйте сервис, не прочитав {polkaswapFaqLink}, {memorandumLink} и {privacyLink}!",me="Отказ от ответственности",ue="Отключиться",pe="Больше не показывать",ge="Перетащите или выберите файл {extension}",Te="Редактировать",ye="Ошибка",be="Обратите внимание, что сетевые комиссии {network} , отображаемые в {AppName} , являются лишь приблизительными оценками. Вы можете увидеть правильную сумму комиссии в подключенном {network} кошельке до подтверждения транзакции.",ke="{amount} ограничена",Se={lossWarning:"Вы потеряете {value}% на своей сделке. Мы обнаружили проблему с обеспечением ликвидности. Это может привести к значительным потерям при обмене токенов. Пожалуйста, убедитесь, что для желаемой пары достаточно ликвидности.",Pool:"Пул",Swap:"Обмен"},xe="Развернуть",he={myPositions:"мои позиции",showOnly:"Показать только {entities}",synthetics:"синтетические токены"},we="{AppName} Часто задаваемые вопросы",Ae="Обратите внимание, что фиатные значения, связанные с криптовалютами на нашем веб-сайте, предоставленные внешними сервисами (Subquery, Subsquid, Ceres API), являются приблизительными. Учитывая присущую этим вычислениям сложность, невозможно гарантировать абсолютную точность в любое время.",fe={cedeStoreBtn:"Перевести из {value1} через {value2}",cedeStoreDesc:"Перенесите любые токены из {value1} в {value2} через {value3}",cedeStoreTitle:"Перевод из {value} биржи",errorMessage:"Приносим извинения за неудобства. Мы прилагаем все усилия, чтобы решить эту проблему. Пожалуйста, повторите попытку позже.",historyBtn:"Мои покупки",historyTitle:"История транзакций",moonpayDesc:"Приобретите токены ETH на {Ethereum} и переведите их в сеть {SORA} через мост.",moonpayTitle:"Купить ETH через MoonPay"},ve={all:"Все",native:"Нативные",reset:"Сброс",show:"Показать",showAssets:"Показать активы",synthetics:"Синтетики",token:"Валюта",verifiedOnly:"Показывать проверенные активы",zeroBalance:"Скрыть 0 баланс активов"},De="{first} в {second}",Re="Первая",Pe={internet:{action:"Обновить {Polkaswap}",desc:{disabled:"Отключено",stable:"Оптимальная скорость",unstable:"Медленное соединение"},dialogDesc:"{Polkaswap} требует подключения к Интернету для стабильной работы",dialogTitle:"Подключиться к источнику Интернета",label:"Ваша скорость интернета",title:{disabled:"Интернет отключен",stable:"Интернет стабилен",unstable:"Интернет нестабилен"}},node:{title:{connected:"Нода подключена",disconnected:"Нода отключена",loading:"Нода переподключается"}},statistics:{action:"Выберите сервисы",desc:{available:"Все сервисы работают стабильно",loading:"Все сервисы загружаются",unavailable:"Все сервисы отключены"},dialog:{indexer:"Индексатор",title:"Выбор сервисов {Sora} сети",useCeres:"Использовать {Ceres} для получения фиатных значений"},label:"Сервисы статистики",title:{available:"Статистика доступна",loading:"Статистика загружается",unavailable:"Статистика недоступна"}}},Be={faucet:"Кран",github:"GitHub",info:"Инфо и сообщество",privacy:"Политика конфиденциальности",sorawiki:"{Sora} Вики"},Oe="за",Ce="Мост {Hashi}",Ne={hideBalances:"Скрыть балансы",hideDisclaimer:"Скрыть дисклеймер",selectCurrency:"Выберите валюту",settings:"Настройки",showBalances:"Показать балансы",showDisclaimer:"Показать дисклеймер",switchTheme:"{theme} режим",systemPreferencesTheme:"Системный режим",titleBalance:"Балансы",titleCurrency:"Фиатная валюта",titleMisc:"Другое",titleTheme:"Цветовая тема",turnPhoneHideBalances:"Повернуть телефон и скрыть."},Le={appVersion:"{AppName} версия",contactUs:"Свяжитесь с нами",privacyPolicy:"Политика конфиденциальности",termsOfService:"Условия предоставления услуг",title:"Помощь"},Me={clearHistory:"Очистить историю",empty:"Здесь появятся Ваши транзакции",emptySearch:"Транзакции не найдены",filterPlaceholder:"Фильтр по Адресу, Символу, Типу или ID Блока"},Ee={balances:{liquidityrestrictions:"Ограничения ликвидности счета препятствуют снятию средств"},demeterfarmingplatform:{insufficientfunds:"Недостаточно средств",insufficientlptokens:"Недостаточное количество токенов обеспечения ликвидности",pooldoesnothaverewards:"Пул не имеет наград"},generalError:"Что-то пошло не так",liquidityproxy:{forbiddenfilter:"Выбранный источник ликвидности не разрешен",slippagenottolerated:"Влияние на цену превысило выбранное значение"},multicollateralbondingcurvepool:{pricecalculationfailed:"Произошла ошибка при расчете цены"},poolxyk:{calculatedvalueisnotmeetsrequiredboundaries:"Суммы выходят за установленные пределы",impossibletodecidevalidpairvaluesfromrangeforthispool:"Предоставленные суммы слишком разняться",sourcebalanceisnotlargeenough:"Исходный баланс недостаточно велик",targetbalanceisnotlargeenough:"Баланс назначения недостаточно велик",unabletodepositxorlessthanminimum:"XOR ниже минимального значения (0,007)",zerovalueinamountparameter:"Параметр суммы имеет нулевое значение"},referrals:{alreadyhasreferrer:"У учетной записи уже есть реферер",referrerinsufficientbalance:"У реферера недостаточно зарезервированного баланса"},vestedrewards:{cantcalculatereward:"Не удалось выполнить расчет вознаграждения",norewardsforasset:"Нет вознаграждений за этот актив",rewardssupplyshortage:"Бонусная программа уже завершена"},xstpool:{poolalreadyinitializedforpair:"Пара пула уже существует",slippagelimitexceeded:"Допустимое отклонение от проскальзывания не достигло надлежащих пределов"}},Fe="Импорт",Ve="Недостаточный баланс {tokenSymbol}",Xe={addCollateral:"Добавить залог",addCollateralDescription:"Внесите больше активов в свою позицию, чтобы увеличить ваш лимит по кредиту или улучшить ваш залоговый коэффициент. Это также может помочь предотвратить ликвидацию.",available:"Доступно",availableToBorrow:"Доступно для займа",availableToBorrowDescription:"Оставшаяся сумма, которую вы имеете право взять при текущих условиях вашей позиции, на основе вашего внесенного залога и существующем долге.",borrowDebt:"Взять долг",borrowMore:"Занять больше",borrowMoreDescription:"Возьмите дополнительные средства из своей позиции до максимально доступной суммы. Убедитесь, что стоимость вашего залога поддерживает увеличение долга, чтобы избежать рисков ликвидации.",borrowTax:"Налог на заем",borrowTaxDescription:"Налог {value}, применяемый к заимствованной сумме",closeVault:"Закрыть мою позицию",closeVaultDescription:"Закрыть выбранную позицию, погасив всю непогашенную задолженность и сняв весь залог",collateralDetails:"Детали залога",createVault:"Открыть позицию",createVaultAction:"Открыть позицию",createVaultDescription:"Откройте новую позицию, внеся в нее залог и взяв средства. Это создает долговое обязательство, которым вам нужно управлять.",debtAvailable:"Долг доступен",debtAvailableDescription:"Сумма средств, которую вы все еще можете получить из своей позиции, не превышая ваш лимит по кредиту, на основе вашего текущего залога.",debtDetails:"Детали долга",depositCollateral:"Внести залог",disclaimerDescription:"Заимствование цифровых активов через {Polkaswap} сопряжено с существенными рисками, за которые вы несете ответственность. Стоимость цифровых активов крайне волатильна, и любые изменения в рыночных ценах активов, которые вы заимствовали или использовали в качестве залога, могут привести к значительным финансовым потерям.",error:{borrowMoreThanAvailable:"Доступный долг превышен",enterBorrow:"Введите сумму заимствования",enterCollateral:"Введите залог",enterRepayDebt:"Введите погашаемый долг",incorrectCollateral:"Пара токенов не поддерживается",insufficientCollateral:"Недостаточно залога",repayMoreThanDebt:"Долг переплачен"},highLiquidationRisk:"Высокий риск ликвидации",interest:"Процент",interestDescription:"Годовая комиссия, взимаемая за сумму, снятую из вашего хранилища, рассчитанная как процент. Этот сбор компенсирует риски и рыночные колебания.",introDescription:"Почувствуйте легкость и безопасность в заеме и кредитовании. Откройте заемные позиции с платформой {Kensetsu}.",introTitle:"Открывайте позиции & Зарабатывайте с {Kensetsu}",liquidated:"Ликвидировано",liquidatedMessage:"Ликвидировано {amount} {symbol}",liquidationClose:"Близка к ликвидации",liquidationPenalty:"Штраф за ликвидацию",liquidationPenaltyDescription:"Штраф, применяемый, если стоимость вашего залога опускается ниже определенного порога, что приводит к продаже активов для покрытия долга. Этот штраф увеличивает ваш общий долг.",ltv:"Залоговый коэффициент ({LTV})",ltvDescription:"Соотношение суммы, взятой в кредит, к стоимости залога в вашей позиции, выраженное в процентах. Большее {LTV} повышает потенциальную доходность, но также и риск, включая возможность ликвидации.",ltvMaxTooltip:"Максимальная сумма заемной позиции, которую можно предоставить относительно оценочной стоимости актива, используемого в качестве залога.",maxAvailableToBorrow:"Макс. доступно для заимствования",maxAvailableToBorrowDescription:"Максимальная сумма, которую вы можете взять из своей позиции, определенная стоимостью вашего залога. Этот лимит корректируется по мере изменения стоимости залога.",minDepositCollateral:"Минимальный депозит залога",minDepositCollateralDescription:"Минимальная сумма активов, необходимая для открытия позиции. Этот первоначальный депозит обеспечивает средства, которые вы хотите занять.",openSwap:"Открыть своп",outstandingDebt:"Непогашенный долг",outstandingDebtDescription:"Общая сумма, которую вы в настоящее время задолжали из средств, полученных из вашей позиции, включая начисленные проценты. Это нужно выплатить, чтобы закрыть вашу позицию или поддерживать залоговый коэффициент на безопасном уровне.",overallAvailable:"Всего доступно",overallAvailableDescription:"Общая сумма средств, доступных для заимствования на платформе {Kensetsu}.",overallBadDebt:"Проблемный долг",overallBadDebtDescription:"Часть задолженности, которая вероятно не будет возвращена из-за несостоятельности заемщика или недостаточного залогового обеспечения.",overallTotalCollateral:"Общая сумма залога",overallTotalCollateralDescription:"Общая стоимость активов, задепонированных заемщиками для обеспечения их кредитных позиций на платформе {Kensetsu}.",overallTotalDebt:"Общий долг",overallTotalDebtDescription:"Общая сумма задолженности, которая в настоящее время остается невыплаченной по всем кредитным позициям на платформе {Kensetsu}.",positionHistory:"История позиций",positionInfo:"Информация о позиции",positionSafe:"Позиция в безопасности",readMore:"Подробнее",reopen:"Открыть заново",repayDebt:"Погасить долг",repayDebtDescription:"Верните заимствованные средства, чтобы уменьшить ваш непогашенный долг. Это может уменьшить затраты на проценты и снизить риск ликвидации.",requiredAmountWithSlippage:"Требуемая сумма с учетом проскальзывания",requiredAmountWithSlippageDescription:"Для плавного закрытия позиции купите немного больше {tokenSymbol} чем требуется ({amount} {tokenSymbol}) из-за возможного проскальзывания. Вам понадобится дополнительное количество, чтобы покрыть остаток. Обменяйте ваши активы на {tokenSymbol}, чтобы удовлетворить эту потребность.",status:{Closed:"Закрыто",Liquidated:"Ликвидировано",Opened:"Открыто"},totalCollateral:"Общий залог",totalCollateralDescription:"Общая стоимость всех активов, в настоящее время находящихся в вашей позиции. Эта стоимость влияет на вашу кредитоспособность и риск ликвидации.",totalCollateralReturned:"Общая возвращенная сумма залога",totalCollateralReturnedDescription:"Общая стоимость активов, возвращенных вам после закрытия вашей позиции, включая оставшийся залог.",yourCollateral:"Ваш залог",yourCollateralDescription:"Активы, которые вы внесли в свою позицию для обеспечения средств, которые вы взяли. Эти активы могут быть ликвидированы кредитором, если вы не сможете поддерживать необходимое соотношение кредита к стоимости.",yourDebt:"Ваш долг",yourDebtDescription:"Общая сумма, которую вы в настоящее время должны в своей позиции, включая взятую сумму и начисленные проценты. Этот остаток увеличивается со временем, когда накапливаются проценты.",yourDebtTokenBalance:"Ваш {tokenSymbol} баланс"},qe="Последняя",Ie="Узнать больше",We="Светлый",He="Расположение",Ue="Выйти",Ke={About:"О приложении",AssetOwnerContainer:"@:pageTitle.AssetOwner",Bridge:"@:bridgeText",Burn:"@:pageTitle.Burn","Explore/Container":"Исследовать",Farming:"Фарминг",OrderBook:"Торговля",Pool:"Пул",Rewards:"Награды",SoraCard:"{Sora} карта",StakingContainer:"Стейкинг",Stats:"Статистика",Swap:"Обмен",VaultsContainer:"@:pageTitle.Vaults",Wallet:"Счет"},Je="Рыночный алгоритм",Ye="Рынок",Ge="макс. сумма",je="Меморандум {AppName} и Условия предоставления услуг",ze="мин. сумма",Qe={header:"Загрузите кошелек {Sora} с функциями {polkaswapHighlight}",info:"Обмен токенами из разных сетей — {Sora}, {Ethereum}, {Polkadot}, {Kusama}. Обеспечьте пул ликвидности и зарабатывайте % от биржевых комиссий.",sideMenu:"Получить {Sora} Wallet"},_e={buttons:{buy:"Купить токены",history:"История покупок",transfer:"Начать трансфер",view:"Посмотреть транзакцию"},confirmations:{txReady:"Транзакция готова для моста"},history:{empty:"@:noDataText",title:"История покупок"},notifications:{accountAddressError:{text:"К сожалению, транзакция моста {Hashi} не удалась из-за того, что адрес получателя токенов в заказе @:moonpayText не соответствует вашему текущему адресу учетной записи {Ethereum}. Пожалуйста, переключите учетную запись {Ethereum} в расширении и повторите попытку.",title:"Неверный {Ethereum} аккаунт"},amountError:{text:"К сожалению, транзакция моста {Hashi} не прошла из-за недостаточного количества токенов для совершения транзакции. Пожалуйста, проверьте баланс вашего аккаунта {Ethereum} и повторите попытку.",title:"Недостаточный баланс"},feeError:{text:"К сожалению, транзакция моста {Hashi} потерпела неудачу из-за того, что не было достаточного количества ETH для оплаты комиссии за транзакцию в сети {Ethereum}. Добавьте еще ETH и повторите попытку.",title:"Недостаточно ETH для транзакции по мосту"},success:{text:"Покупка токенов завершена. Транзакция моста {Hashi} начнется автоматически, как только токены будут получены на подключенный счет {Ethereum}. Можно закрыть это окно и продолжить использование {AppName}. Когда транзакция моста будет готова, появится уведомление о ней.",title:"Токены куплены"},supportError:{text:'К сожалению, токен, приобретенный через @:moonpayText, еще не поддерживается мостом {Hashi} в {AppName}. Обычно только поддерживаемые токены должны быть доступны для покупки через MoonPay в {AppName}, следовательно, где-то что-то пошло не так. Не стесняйтесь сообщить сообществу об этом случае в <a class="link" href="https://t.me/polkaswap" target="_blank" rel="nofollow noopener" title="{AppName}"> группу {AppName} в Telegram </a> .',title:"Токен не поддерживается"},transactionError:{text:'К сожалению, похоже, что транзакция @:moonpayText не удалась. Повторите попытку. Для поддержки @:moonpayText перейдите по ссылке <a class="link" href="https://support.moonpay.com" target="_blank" rel="nofollow noopener" title="@:moonpayText">https://support.moonpay.com</a>',title:"Транзакция не удалась"}},tooltips:{transfer:`Токены успешно куплены!
