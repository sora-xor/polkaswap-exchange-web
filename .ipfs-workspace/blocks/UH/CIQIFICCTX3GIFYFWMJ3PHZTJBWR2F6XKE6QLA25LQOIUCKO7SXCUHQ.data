  position: relative;
}
.asset-logo__nft-image[data-v-3f665578] {
  border-radius: 50%;
  object-fit: cover;
  position: absolute !important;
  top: 0;
  left: 0;
}
.asset-logo--clickable[data-v-3f665578] {
  cursor: pointer;
}
.asset-logo--mini[data-v-3f665578] {
  height: 16px;
  width: 16px;
}
.asset-logo--mini[data-v-3f665578] {
  display: flex;
  justify-content: center;
  background-color: var(--s-color-base-on-accent);
  color: var(--s-color-base-content-tertiary);
  background-size: 60%;
  background-repeat: no-repeat;
  background-position: 50%;
  border-radius: 50%;
  text-align: center;
  line-height: 16px;
  font-size: 12px;
  color: var(--s-color-base-content-tertiary);
}
.asset-logo--mini.asset-logo-nft[data-v-3f665578]::before {
  content: "NFT";
  font-size: 6px;
}
.asset-logo--small[data-v-3f665578] {
  height: 24px;
  width: 24px;
}
.asset-logo--small[data-v-3f665578] {
  display: flex;
  justify-content: center;
