  display: flex;
  flex-flow: column nowrap;
  gap: calc(var(--s-basic-spacing) * 2);
  width: 100%;
}
.settings-option.disabled[data-v-9665b032] {
  opacity: 0.6;
}
.settings-option-label[data-v-9665b032] {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  gap: calc(var(--s-basic-spacing) * 2);
}
.settings-option-label[data-v-9665b032]:not(.disabled) {
  cursor: pointer;
}
.settings-option-label-description[data-v-9665b032] {
  display: flex;
  flex-flow: column nowrap;
  align-items: flex-start;
  font-size: var(--s-font-size-medium);
  font-weight: 300;
