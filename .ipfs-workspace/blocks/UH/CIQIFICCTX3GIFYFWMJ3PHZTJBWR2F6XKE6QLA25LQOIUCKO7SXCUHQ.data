  display: flex;
  align-items: center;
}
.account-card > .el-card__body {
  flex: 1;
  max-width: 100%;
}
.account-card.s-card.neumorphic {
  border-width: 0px;
  border-style: solid;
  border-color: transparent;
}
.account-card.s-card.neumorphic.s-size-small {
  padding: var(--s-basic-spacing) calc(var(--s-basic-spacing) * 2);
}
.account-avatar > img {
  max-width: 100%;
}
.account-details .el-button + .el-button {
  margin-left: 0;
}`,map:void 0,media:void 0}),Ya("data-v-c5463418_1",{source:`.account[data-v-c5463418] {
  display: flex;
  align-items: center;
  gap: calc(var(--s-basic-spacing) * 1.5);
}
.account-avatar[data-v-c5463418] {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  overflow: hidden;
}
.account-details[data-v-c5463418] {
  flex: 1;
  align-items: center;
  max-width: calc(100% - var(--s-basic-spacing) * 1.5 - 32px);
}
.account-credentials[data-v-c5463418] {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}
.account-credentials_name[data-v-c5463418], .account-credentials_description[data-v-c5463418] {
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: var(--s-letter-spacing-small);
}
.account-credentials_name[data-v-c5463418] {
  font-size: var(--s-font-size-medium);
  font-weight: 600;
  line-height: var(--s-line-height-medium);
  outline: none;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.account-credentials_description[data-v-c5463418] {
  width: -webkit-fit-content;
  width: -moz-fit-content;
  width: fit-content;
  color: var(--s-color-base-content-secondary);
  font-size: var(--s-font-size-mini);
  font-weight: 300;
  line-height: var(--s-line-height-medium);
