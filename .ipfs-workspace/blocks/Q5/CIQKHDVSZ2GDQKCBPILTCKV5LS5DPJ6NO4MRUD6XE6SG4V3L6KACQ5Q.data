exportAccount:"ייצא את קובץ __ph__0__",selectAccount:"בחר את החשבון שברצונך לייצא",selectWallet:"פתח את הארנק עם החשבונות / ים הקיימים שלך"},password:{desc:"ודא שאתה משתמש בסיסמה ייחודית חזקה להגנה נאותה (8 תווים מינימום)",placeholder:"סִיסמָה"},seedAdviceAdditionText:"אם מישהו מבקש ממך את ביטוי הסיסמה שלך, סביר להניח שהם מנסים להטריד אותך ולגנוב את הנכסים שלך!",seedAdviceAdditionTitle:"לעולם אל תשתף את משפט הסיסמה שלך עם מישהו!",seedAdviceText:"משפט הסיסמה בן 12 המילים הוא מפתח פרטי להחזרת גישה לחשבון __ph__0__ שלך למקרה שתאבד גישה לחשבון __ph__1__ שלך. אחסן אותו בבטחה בסדר המדויק שהוא מופיע לעיל.",welcome:{createAccount:"צור חשבון",header:"ברוך הבא ל- __ph__0__!",headline:"בואו נקבע את חשבונך",importAccount:"חשבון יבוא",text:"צור את חשבון הרשת __ph__0__ שלך או היכנס אליהם הישנים באמצעות ביטוי mnemonic או יבוא .json. זה מאפשר לך לחתום היטב על עסקאות ולנהל נכסים ברשת __ph__1__."}},l_={marketAlgorithm:"@.upper: MarketalGorithMtext",marketAlgorithms:{SMART:"ניתוב נזילות __ph__0__ מבטיח את המחיר הטוב ביותר עבור כל עסקה על ידי שילוב רק אפשרויות המחיר הטובות ביותר מכל השווקים הזמינים. כאשר הוא זמין, עקומת מליטה אסימון (__ph__1__) תשמש לנזילות כל עוד מחיר הנכס זול יותר מאשר ממקורות אחרים, עליהם משתמשים בבריכת __ph__2__.",TBC:"__Ph__0__ - קנייה רק ​​מעקומת האגודה האסימון (שוק ראשוני). קיימת אפשרות שהמחיר יכול להיות שלילי בהשוואה לבריכת __ph__1__ (שוק משני), אך הערך שהתקבל מהתגמולים המוקנים עשוי להתברר כחיובי הרבה יותר לאורך זמן.",XYK:"__Ph__0__ - קנייה רק ​​מבריכת XYK (שוק משני). החלפת בריכת XYK מסורתית."},marketAlgorithmTooltip:{main:"- אפשרות לבחור בין שוק ראשי (TBC), שוק משני (XYK) או אלגוריתם חכם משולב עבור המחיר הטוב ביותר המובטח לכל עסקה נתונה."},slippageTolerance:"סובלנות להחליק",slippageToleranceHint:"העסקה שלך תחזור אם המחיר ישתנה באופן לא חיובי באחוז זה.",slippageToleranceValidation:{error:"הזן אחוז החלקה תקף",frontrun:"העסקה שלך עשויה להיות חזיתית",warning:"העסקה שלך עלולה להיכשל"},title:"הגדרות"},c_="__Ph__0__ אתר זה נשמר על ידי קהילת __ph__1__. לפני שתמשיך להשתמש באתר זה, אנא עיין ב- __ph__2__ והתיעוד, הכולל הסבר מפורט כיצד עובד __ph__3__, כמו גם את __ph__4__ ו- __ph__5__. מסמכים אלה הם מכריעים לחוויית משתמש מאובטחת וחיובית. על ידי שימוש __ph__6__, אתה מאשר כי קראת והבנת מסמכים אלה. אתה גם מאשר את הדברים הבאים: 1) האחריות הבלעדית שלך לעמידה בכל החוקים שעשויים לחול על השימוש הספציפי שלך ב- __ph__7__ בתחום השיפוט החוקי שלך; 2) ההבנה שלך שהגרסה הנוכחית של __ph__8__ היא גרסת אלפא: היא לא נבדקה במלואה, ופונקציות מסוימות עשויות שלא להתפקד כמתוכנן; 3) הבנתך וקבלה מרצון של הסיכונים הכרוכים בשימוש __ph__9__, כולל, אך לא רק, הסיכון לאבד אסימונים. אנא אל תמשיך בלי לקרוא את __ph__10__, __ph__11__, __ph__12__!",p_="הצהרת אחריות",d_="לְנַתֵק",h_="אל תראה לי את זה שוב",u_="גרור ושחרר או בחר קובץ __ph__0__",T_="לַעֲרוֹך",m_="שְׁגִיאָה",g_="שימו לב כי דמי הרשת __ph__0__ המוצגים ב- __ph__1__ הם רק הערכות גסות, תוכלו לראות את סכום העמלה הנכון בארנק __ph__2__ המחובר שלכם לפני אישור העסקה.",x_="__Ph__0__ חרג",k_={lossWarning:"אתה הולך לאבד __ph__0% __% על הסחר שלך. גילינו סוגיית אספקת נזילות. זה עלול להוביל להפסדים משמעותיים במהלך החלפות אסימון. אנא וודא שיש נזילות מספקת עבור זוג ההחלפות הרצוי שלך.",Pool:"פּוּל",Swap:"לְהַחלִיף"},S_="לְהַרְחִיב",f_={myPositions:"העמדות שלי",showOnly:"להראות רק __ph__0__",synthetics:"אסימונים סינתטיים"},w_="__Ph__0__ שאלות נפוצות",y_="שימו לב כי ערכי הפיאט המשויכים לקריפטו -מטבעות באתר שלנו ניתנים על ידי שירותים חיצוניים (תת -שאת, SubsQuid, API של CERES) הם משוערים. בהתחשב במורכבות המובנית של חישובים אלה, לא ניתן להבטיח דיוק מוחלט בכל עת.",b_={cedeStoreBtn:"העברה מ- __ph__0__ דרך __ph__1__",cedeStoreDesc:"העבר אסימונים מ- __ph__0__ ל- __ph__1__ דרך __ph__2__",cedeStoreTitle:"העברה מ- __ph__0__",errorMessage:"מתנצל על אי הנוחות. אנו פועלים בשקדנות כדי לפתור זאת. אנא נסה שוב מאוחר יותר.",historyBtn:"הרכישות שלי",historyTitle:"היסטוריית עסקאות",moonpayDesc:"רכוש אסימוני ETH ב- __ph__0__ והעביר אותם לרשת __ph__1__ דרך הגשר",moonpayTitle:"קנו את ETH באמצעות MoonPay"},P_={all:"כֹּל",native:"יָלִיד",reset:"אִתחוּל",