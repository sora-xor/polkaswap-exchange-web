save:"שמור שינויים",select:"בחר מאמת",selected:"__Ph__0 __/__ pH__1__ נבחר",tooManyValidators:"יותר מדי מאמתים שנבחרו (__ph__0__ __ph__1__)"},validatorsAttentionDialog:{confirm:"כן, אני מבין את הסיכון",description:{0:"הצעות מאמת אלגוריתמיות אינן מהוות ייעוץ או ייעוץ פיננסי. ההפעלה היא פעילות בסיכון גבוה, והצעות מאמת אלגוריתמי אינן בהכרח מקלות על סיכון זה.",1:"עדיין ניתן עדיין לחתוך מאמת שהציע האלגוריתם. מאמת המוצע על ידי האלגוריתם יכול גם לשנות את הפרמטרים שלהם (למשל, שיעורי עמלה וכו ') בכל עת לאחר שהוצעו ו/או נבחרו.",2:"אתה יכול לאבד אסימונים או תגמולים מסיבות אלה או אחרות. רק אסימוני כתם והשתמשו בהצעות מאמת על פי שיקול דעתכם, לאחר ביצוע בדיקת נאותות ובהתחשב בזהירות בהתחשב בסיכונים הכרוכים בכך."},title:"תְשׁוּמַת לֵב"},validatorsDialog:{tabs:{all:"כֹּל",user:"שֶׁלְךָ"},title:{edit:"ערוך את המאמת שלי"}},validatorsFilterDialog:{filters:{hasIdentity:{description:"לפחות איש קשר זהות אחד המחובר לחשבון",name:"זהות על שרשרת"},notOversubscribed:{description:"חשבון בגבול ההקצאה, נמנע מעונשים של המנוי יתר על __ph__0__.",name:"לא מנוי יתר על המידה"},notSlashed:{description:"לא חוו עונשים או הפחתה בכספים המוקדמים שלהם בגלל הפרות התנהגות שגויה או פרוטוקול.",name:"לא נחתך"},twoValidatorsPerIdentity:{description:"מקסימום שני תוקפים לכל זהות לקידום ביזור ולמנוע ריכוז הכוח.",name:"גבול של 2 מאשרים לכל זהות"}},reset:"לאפס את הכל",save:"שמור פילטר",title:"פילטרים"},validatorsList:{commission:"עֲמָלָה",commissionTooltip:"העמלה מתייחסת לתשלום שגובה תוקפים בגין שירותיהם בתהליך ההפעלה. שכר טרחה זה, המתבטא כאחוזים, מנוכה מהתגמולים המגיעים שהרוויחו המועמדים לפני ההפצה. חשוב לציין כי תוקפים יכולים להתאים את שיעורי העמלה שלהם בכל עת",name:"שֵׁם",noNominatedValidators:"אין לך תוקפים מועמדים",noValidators:"אין מאמתים המספקים את המסנן שצוין",return:"לַחֲזוֹר",search:"לְחַפֵּשׂ..."},withdraw:{beingWithdrawn:"להיות נסוג",countdownLeft:"שְׁמֹאל",nextWithdrawal:"הנסיגה הבאה",seeAll:"ראה הכל",withdrawable:"נסוג"},withdrawDialog:{showAllWithdraws:"הראה את כל הנסיגות",title:"למשוך כספים שלא הושלמו"}},Ge="שָׁלָב",je="הַצלָחָה",Qe={confirmSwap:"אישור החלפה",errorFetching:"שגיאה בעת אחזור הנתונים",insufficientAmount:"כמות {tokenSymbol} בלתי מספקת",insufficientLiquidity:"נזילות בלתי מספקת",liquidityProviderFee:"עמלת ספק נזילות",liquidityProviderFeeTooltip:"חלק מכל עסקה ({liquidityProviderFee}%) מועבר לספקי הנזילות כתמריץ פרוטוקול.",maxSold:"מקסימום נמכר",minReceived:"מינימום שיתקבל",minReceivedTooltip:"העסקה תבוטל אם יחול שינוי מחיר גדול ולא מיטיבי לפני האישור.",priceImpact:"השפעת מחיר",priceImpactTooltip:"ההבדל בין מחיר השוק למחיר המשוער עקב גודל העסקה.",rewardsForSwap:"תגמולי PSWAP אסטרטגיים",route:"מסלול",slippageTolerance:"סבילות החלקה",swapOutputMessage:"הפלט הוא הערכה. תקבלו לפחות {transactionValue} או שהעסקה תבוטל."},Ye="החלף",ze={assetId:"מזהה נכס"},Je={accounts:"חשבונות הם כתובות דיגיטליות המחזיקות בנכסי המשתמש ברשת. כל חשבון משויך לכתובת ציבורית ייחודית ולמפתח פרטי המאפשר למשתמש לגשת ולנהל את נכסיו.",bridgeTransactions:"__Ph__0__ עד __ph__1__ גשר מתייחס לתהליך העברת נכסים בין רשתות __ph__2__ ל- __ph__3__ באמצעות גשר. הגשר מאפשר יכולת פעולה הדדית של שתי הרשתות, ומאפשר למשתמשים להעביר בצורה חלקה נכסים ביניהם.",fees:"עמלות ב- __ph__0__ blockchain מתייחסות לחיובים שנמצאים בביצוע עסקאות ברשת. עמלות אלה משולמות ב- XOR, הקריפטו המקורי של רשת __ph__1__. סכום העמלה נקבע על ידי המורכבות וגודל העסקה שמתבצעת",roi:"__Ph__0__ מהווה החזר השקעה. זה מחושב על ידי חלוקת הרווח שנצבר בהשקעה בעלות ההשקעה ההיא באחוזים שווה ערך.",supply:"אספקת האסימון מתייחסת למספר האסימונים הכולל שנוצרו ונמצאים במחזור ברשת. אספקת האסימון יכולה להשתנות בהתבסס על כמות האסימונים שנשרפים, נשרפים או מועברים ברשת.",transactions:"עסקאות מתייחסות לתהליך שליחת או קבלת נכסים דיגיטליים ברשת, כולל פעולות נזילות וכן החלפות.",tvl:"__Ph__0__ מהווה ערך סך הכל נעול. הוא מייצג אסימונים נעולים בבריכות בשווי הדולר.",velocity:"מהירות האסימון היא מספר הפעמים של אסימון חשבונות במהלך התקופה (חודש) בממוצע. זה מציין את רמת פעילות המסחר והנזילות.",volume:"הנפח מתייחס לסכום הכולל של הנכסים שנסחרו או הוחלפו ברשת לאורך פרק זמן מסוים. הנפח הוא מדד חשוב למדידת הנזילות והפעילות הכוללת של הרשת."},$e={amount:"@:amountText",amount2:"__Ph__0__ 2",blockId:"מזהה חסום",comment:"הֶעָרָה",copy:"העתק __ph__0__",fee:"דמי עסקה",from:"מִן",history:{confirmed:"העסקה אושרה",created:"נוצרה עסקה עבור __ph__0__ __ph__1__.",submitted:"עסקה המוגשת בתשלום של __ph__0__ __ph__1__"},price:"מְחִיר",referral:"הפניה",referrer:"מפנה",side:"צַד",startTime:"תַאֲרִיך",status:"סטָטוּס",statuses:{complete:"לְהַשְׁלִים",failed:"העסקה נכשלה",pending:"תָלוּי וְעוֹמֵד..."},title:"פרטי עסקה",to:"אֶל",total:"סַך הַכֹּל",txId:"מזהה עסקה",viewIn:"תצוגה ב- __ph__0__"},Ze="פרטי עסקה",_t="הוגשה עסקה",et="עסקה | עסקאות",tt={from:"מ",to:"אל"},ot="נכס לא ידוע",it="שגיאה משהו השתבש ...",nt={WalletAssets:"נכסים",WalletHistory:"פְּעִילוּת"},rt={addressError:"אינך יכול לשלוח אסימונים לאותו חשבון שאתה מחובר אליו כרגע.",addressWarning:"אסימונים יישלחו לכתובת __ph__0__ למטה. וודא שהמקבל יכול לגשת לשרשרת __ph__1__ כדי להשתמש באסימונים:",badAddress:"כתובת שגויה",balance:"לְאַזֵן",confirmTitle:"אשר את העסקה",enableVesting:"אפשר הבשת אסימון",enterAddress:"הזן כתובת",enterAmount:"הזן סכום",enterVestingPercentage:"הזן אחוז ההבשלה",errorAddress:"כתובת לא חוקית. אנא בדוק את זה ונסה שוב.",max:"MAX",startUnlockingDate:"התחל תאריך ביטול נעילה",title:"לִשְׁלוֹחַ",tooltip:"שלח אסימונים בין חשבונות רשת __ph__0__",unlockFrequency:"ביטול נעילת תדר",vestingPercentage:"אחוז ההבשלה"},at="אַזהָרָה",st={acceptOnScrollText:_,acceptText:e,account:t,accountAddressText:o,accountSettings:i,accountText:n,addAsset:r,addAssetsText:a,addAssetText:s,addLiquidity:l,addressBook:c,addressText:p,alerts:d,amountText:h,appName:u,asset:T,assetDeposit:m,assetOwner:g,assets:x,backText:k,balanceText:S,blockNumberText:f,bridge:w,bridgeHistory:y,bridgeText:b,bridgeTransaction:P,bridgeTransferNotification:A,browserNotificationDialog:D,browserNotificationLocalStorageOverride:v,browserPermission:B,buttons:R,calculatingText:M,cancelText:O,changeAccountText:C,changeNetworkText:L,closeText