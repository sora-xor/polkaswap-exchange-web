ading:"כדי לעבד את ההזמנה, אנא הזן מחיר שהוא מכפיל של __ph__0__",reason:"המחיר שהוזן הוא ספציפי מדי"},outOfBounds:{reading:"טווח ה- blockchain חרג: הסכום שהוזן שלך נופל מחוץ לטווח המותר של blockchain. דקות: __ph__0__; מקסימום: __ph__1__",reason:"הסכום נכשל בציית לטווח blockchain"},singlePriceLimit:{reading:"הגבלה שהושגה: כל מיקום מוגבל למספר 1024 הוראות הגבלה. אנא המתן עד שממלאים כמה הזמנות",reason:"יותר מדי הזמנות נמשכות במחיר זה"},spotLimit:{reading:"כובע טווח מחירים: כל צד ספר הזמנות מוגבל ל 1024 נקודות מחיר ייחודיות. אנא בחר מחיר בטווח הקיים או המתן לחלל שיהיה זמין",reason:"הצד המסחר התמלא"}},history:{cancel:"בטל את הזמנה __ph__0__",cancelAll:"בטל את הכל",connect:"חבר חשבון כדי להתחיל לסחור",openOrders:"פתיחת הזמנות __ph__0__",orderHistory:"היסטוריה של הזמנה",tradeHistory:"היסטוריית סחר"},limit:"לְהַגבִּיל",market:"שׁוּק",marketTrades:"סחר בשוק",month:"חוֹדֶשׁ",orderBook:"ספר הזמנה",orderStatus:{active:"פָּעִיל",canceled:"בּוּטלָה",expired:"פג תוקף",filled:"מְמוּלָא"},orderTable:{filled:"מְמוּלָא",lifetime:"מֶשֶׁך הָחַיִים",noOrders:"אין הזמנות. צור את הראשון שלך!",pair:"זוּג",side:"צַד",time:"זְמַן"},Sell:"למכור __ph__0__",setPrice:"מחיר מוגדר",stop:"הספר נעצר",time:"זְמַן",tokenPair:"זוג אסימון",tooltip:{bookStatus:{active:"פונקציונליות מסחר מלאה מופעלת. אתה יכול לבצע הזמנות חדשות או לבטל את הקיימות.",cancelable:"אתה יכול לבטל רק הזמנות קיימות. מיקום הזמנה חדש מושבת כעת.",inactive:"כל פעילויות המסחר נעצרות כעת. בשלב זה לא ניתן להציב או לבטל הזמנות.",placeable:"פונקציונליות מוגבלת. אתה יכול לבצע הזמנות חדשות ולבטל תכונות קיימות, אך תכונות מסוימות עשויות להיות אינן זמינות."},bookWidget:"שיא חי ומעדכן כל העת של קנייה (BID) ומכור (שאל) הזמנות לנכס ספציפי, המאורגן לפי רמת מחיר. ספר ההזמנות מציג את עומק השוק, כולל כמויות הנכסים המוצעים במחירים שונים. סוחרים מנצלים תצוגה מפורטת זו כדי לאמוד את סנטימנט השוק, לזהות רמות התנגדות ותמיכה פוטנציאליות ולצפות תנועות מחירים על בסיס ביקוש והיצע קיימים",limitOrder:"הזמנת 'מגבלה' מאפשרת לך לציין את המחיר המדויק בו ברצונך לקנות או למכור נכס. הזמנת 'קניית מגבלה' תבוצע רק במחיר שצוין או נמוכה יותר, ואילו הזמנת 'מכירת גבול' תבצע רק במחיר שצוין ומעלה. בקרה זו מבטיחה שלא תשלם יותר או תמכור בפחות ממה שנוח לך.",marketOrder:"'הזמנת שוק' היא הזמנה לקנות או למכור מייד במחיר הנוכחי הזמין ביותר. זה לא דורש קביעת מחיר, להבטיח ביצוע מהיר אך עם הסחר של פחות שליטה על המחיר שהתקבל או תשלום. סוג זה של סדר משמש כאשר וודאות הביצוע היא בראש סדר העדיפויות על פני בקרת מחירים.",marketWidget:"יישומון זה מציג זרם בזמן אמת של עסקאות מבוצעות בשוק, ומספק מידע על נפחי עסקאות, פעילות אחרונה ומגמות שוק נוכחיות. על ידי התבוננות בתזמון, במחיר ובגודל המקצועות בפועל, סוחרים יכולים לקבל תובנות על דינמיקת השוק והרגש, לעזור להם לאתר הזדמנויות מסחר ולקבל החלטות מושכלות",pairsList:"רשימה בזמן אמת המציגה הזמנות קנייה ומכירה עדכניות עבור cryptocurrency. זה עוזר לך להבין את הביקוש, כיוון המחיר הפוטנציאלי ואת נפח הסחר ברשת __ph__0__ ו- __ph__1__ dex",txDetails:{amount:"'הסכום' מתייחס למספר הנכסים הכולל שאתה רוצה לקנות או למכור בהזמנה שלך. חשוב לציין, מכיוון שהיא קובעת את גודל העסקה שלך, ומשפיעה על העלות הכוללת עבור הזמנות קנייה או הכנסות עבור הזמנות מכירה.",expiryDate:"'תאריך התפוגה' הוא המועד האחרון לביצוע ההזמנה שלך. אם השוק לא מגיע למחיר שצוין לפני תאריך זה, ההזמנה מבוטלת אוטומטית. אתה לא מחויב להמתנה תמידית אם תנאי השוק לא יתיישרו עם העדפות המסחר שלך.",limit:"'מחיר המגבלה' הוא המחיר המדויק שהגדרת להזמנת הגבלה. הסחר יבצע רק כאשר מחיר השוק של הנכס עומד במחיר המגבלה שלך, ומבטיח שלא לרכוש למעלה או למכור מתחת לערך שצוין זה.",locked:'ה"נעול "מראה את כמות הנכס שיש לקיים בזמן ההזמנה נמשכת.',orderType:"הזמנת 'קנה' תבוצע רק במחיר שצוין או נמוכה יותר, ואילו הזמנת 'מכירה' תבצע רק במחיר שצוין ומעלה. בקרה זו מבטיחה שלא תשלם יותר או תמכור בפחות ממה שנוח לך."}},total:"סַך הַכֹּל",tradingPair:{choosePair:"בחר זוג מסחר",status:"סטָטוּס",total:"__Ph__0__ __ph__1__ ב __ph__2__ __ph__3__",volume:"כֶּרֶך"},txDetails:{expiryDate:"תאריך תפוגה",limitPrice:"מחיר הגבלה",orderType:"סוג הזמנה"}},he={AddLiquidity:"הוסף נזילות",AssetOwner:"בעל נכס",AssetOwnerDe