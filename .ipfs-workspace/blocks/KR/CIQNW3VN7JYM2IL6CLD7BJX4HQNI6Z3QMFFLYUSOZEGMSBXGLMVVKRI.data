
 ˜.settings-alert-popover{background-color:var(--s-color-utility-body);border:none;border-radius:16px;color:var(--s-color-base-content-primary);font-size:var(--s-font-size-small);padding:16px 8px 16px 16px}.alerts-list-scrollbar.el-scrollbar{margin-left:-24px;margin-right:-24px}.alerts-list-scrollbar.el-scrollbar>.el-scrollbar__wrap{margin-bottom:0!important;overflow-x:hidden}.alerts-list-scrollbar.el-scrollbar>.el-scrollbar__wrap,.alerts-list-scrollbar.el-scrollbar>.el-scrollbar__wrap>.el-scrollbar__view{display:flex;flex:1;flex-flow:column nowrap}.alerts-list-scrollbar.el-scrollbar>.el-scrollbar__bar.is-vertical{right:2px}.alerts-list[data-v-b7ef49ea]{max-height:346px}.alerts-list__item[data-v-b7ef49ea]{margin:0 24px 8px}.alerts-list__type[data-v-b7ef49ea]{background-color:var(--s-color-utility-surface);border-radius:calc(var(--s-border-radius-mini)/2);color:var(--s-color-base-content-secondary);padding:8px}.alerts-list__type[data-v-b7ef49ea]:hover{cursor:default}.alerts-list span.condition[data-v-b7ef49ea]{font-weight:400}.alerts-list span.current-price[data-v-b7ef49ea]{color:var(--s-color-status-info)}.alerts-list .options-icon[data-v-b7ef49ea]{color:var(--s-color-base-content-tertiary)}.alerts-list .options-icon[data-v-b7ef49ea]:hover{cursor:pointer}.settings-alert-section[data-v-b7ef49ea]{align-items:center;display:flex;justify-content:flex-start;margin-bottom:16px;padding:0 calc(var(--s-basic-spacing)*1.5)}.settings-alert-section span[data-v-b7ef49ea]{font-size:var(--s-font-size-medium);font-weight:300;letter-spacing:var(--s-letter-spacing-small);line-height:var(--s-line-height-medium);margin-left:calc(var(--s-basic-spacing)*1.5)}.settings-alert-section span.create[data-v-b7ef49ea]{font-weight:450}.settings-alert-option[data-v-b7ef49ea]{font-size:var(--s-font-size-medium);font-weight:300;letter-spacing:var(--s-letter-spacing-small);line-height:150%}.settings-alert-option span[data-v-b7ef49ea]{margin-left:8px}.settings-alert-option[data-v-b7ef49ea]:hover{cursor:pointer}.settings-alert-option:hover i[data-v-b7ef49ea]{color:var(--s-color-base-content-primary);cursor:pointer}.settings-alert-option i[data-v-b7ef49ea]{color:var(--s-color-base-content-secondary)}
