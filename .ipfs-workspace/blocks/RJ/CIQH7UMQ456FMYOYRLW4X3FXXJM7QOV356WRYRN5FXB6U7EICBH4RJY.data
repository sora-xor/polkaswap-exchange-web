
œ”.reward-item-tooltip{background-color:var(--s-color-status-success);border:1px solid var(--s-color-base-border-secondary);border-radius:var(--s-border-radius-mini);box-shadow:var(--s-shadow-dialog);padding:8px 12px}.reward-item-tooltip-content{font-size:var(--s-font-size-small);line-height:var(--s-line-height-small);text-transform:uppercase}.reward-item-tooltip-value{font-size:var(--s-font-size-medium);font-weight:600;margin-right:auto}.reward-item-tooltip-value-icon{color:var(--s-color-base-content-tertiary);margin-left:4px}
