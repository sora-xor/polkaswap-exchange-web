<html lang="en">
  <head>
    <script>
      (function () {
        try {
          if (typeof window === 'undefined') {
            return;
          }

          var location = window.location;
          if (!location) {
            return;
          }

          var hostname = (location.hostname || '').toLowerCase();
          var localHostnames = ['localhost', '127.0.0.1', '::1', '[::1]'];
          var localSuffixes = ['.localhost'];
          var ipv4Pattern = /^\d{1,3}(\.\d{1,3}){3}$/;
          var privateRanges = [
            /^127\.(\d{1,3}\.){2}\d{1,3}$/,
            /^10\.(\d{1,3}\.){2}\d{1,3}$/,
            /^192\.168\.(\d{1,3})\.\d{1,3}$/,
            /^172\.(1[6-9]|2\d|3[0-1])\.(\d{1,3})\.\d{1,3}$/,
            /^169\.254\.(\d{1,3})\.\d{1,3}$/,
          ];

          var isLocalHost =
            localHostnames.indexOf(hostname) !== -1 ||
            localSuffixes.some(function (suffix) {
              return hostname.endsWith(suffix);
            }) ||
            (ipv4Pattern.test(hostname) &&
              privateRanges.some(function (pattern) {
                return pattern.test(hostname);
              }));

          if (location.protocol === 'http:' && !isLocalHost) {
            location.protocol = 'https:';
            return;
          }

          var pathname = location.pathname || '';
          if (!pathname || pathname === '/' || pathname.endsWith('/')) {
            return;
          }

          var segments = pathname.split('/');
          var lastIndex = segments.length - 1;
          var lastSegment = segments[lastIndex] || '';

          if (lastSegment && lastSegment.indexOf('.') !== -1) {
            segments[lastIndex] = '';
          } else {
            segments.push('');
          }

          var normalizedPath = segments.join('/');
          if (normalizedPath !== pathname) {
            var search = location.search || '';
            var hash = location.hash || '';
            location.replace(normalizedPath + search + hash);
          }
        } catch (error) {
          console.warn('[redirect] skipped', error);
        }
      })();
    </script>
