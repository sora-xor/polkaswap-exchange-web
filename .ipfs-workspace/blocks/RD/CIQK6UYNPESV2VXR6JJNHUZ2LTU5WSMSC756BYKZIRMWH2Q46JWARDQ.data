      <div class="offline-shell__brand">
        <h1>Polkaswap</h1>
        <p>Offline preview</p>
      </div>
      <header class="app-header">
        <nav class="offline-nav">
          <a href="#/swap" data-offline-link="swap">Swap</a>
          <a href="#/bridge" data-offline-link="bridge">Bridge</a>
        </nav>
