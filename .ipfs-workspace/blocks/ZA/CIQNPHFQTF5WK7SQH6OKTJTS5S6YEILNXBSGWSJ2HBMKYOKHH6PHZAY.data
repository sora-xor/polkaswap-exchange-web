  background-color: var(--s-color-utility-body);
  border-radius: 16px;
  color: var(--s-color-base-content-primary);
  border: none;
  padding: 16px 16px 0 16px;
  font-size: var(--s-font-size-small);
}
.assets-filter.el-popover .el-radio {
  font-weight: 300;
  margin-right: 20px;
}
.assets-filter.el-popover .el-radio .el-radio__label {
  font-size: var(--s-font-size-small);
}
.assets-filter__headline {
  display: flex;
}
.assets-filter__headline .assets-filter__text--reset {
  position: absolute;
  right: 16px;
  color: var(--s-color-theme-accent);
}
.assets-filter__headline .assets-filter__text--reset:hover {
  cursor: pointer;
}
.assets-filter-options {
  display: flex !important;
  flex-direction: column;
  margin-bottom: 16px;
}
.assets-filter__text {
  margin-bottom: 4px;
}
.assets-filter__button {
  background-color: var(--s-color-base-border-primary);
  padding: 3px 8px;
  border-radius: 10px;
  transition: 0s background-color;
  color: var(--s-color-base-content-primary);
  font-weight: 300;
}
.assets-filter__button-option {
  color: var(--s-color-theme-accent);
}
.assets-filter__button .assets-filter__button-icon {
  color: var(--s-color-base-content-tertiary);
  margin-left: 6px;
}
.assets-filter__button:hover {
  cursor: pointer;
  background-color: var(--s-color-base-border-secondary);
  transition-delay: 0.05s;
}
.assets-filter .el-divider--horizontal {
  margin: 16px 0;
}`,map:void 0,media:void 0}))},tu,"data-v-063cd3b8",!1,void 0,!1,zt$3);let su=class extends Mixins(Er$1){constructor(){super(...arguments);T0(this,"model");T0(this,"SYNTHS_LINK","https://medium.com/polkaswap/unveiling-synthetic-assets-a-game-changer-in-the-financial-landscape-1720e5858422")}};__decorate$2([ModelSync("value","input",{type:Boolean})],su.prototype,"model",void 0),su=__decorate$2([OptionsDecorator({components:{ExternalLink:Fc$1}})],su);const iu=su;var ru=function(){var Ya=this,ou=Ya.$createElement,vu=Ya._self._c||ou;return vu("div",{staticClass:"switcher"},[vu("s-switch",{model:{value:Ya.model,callback:function(e0){Ya.model=e0},expression:"model"}}),Ya._v(" "),vu("span",[Ya._v(`
