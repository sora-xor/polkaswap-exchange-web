  display: flex;
  flex-direction: column;
  align-items: center;
  gap: calc(var(--s-basic-spacing) * 2);
}
.login-btn[data-v-2e72b224] {
  width: 100%;
}
.login-btn.el-button + .login-btn.el-button[data-v-2e72b224] {
  margin-left: 0;
}
.login__inputs[data-v-2e72b224] {
  display: flex;
  flex-direction: column;
  gap: calc(var(--s-basic-spacing) * 2);
  width: 100%;
}
.login__text[data-v-2e72b224] {
  color: var(--s-color-base-content-primary);
  font-size: var(--s-font-size-extra-small);
  font-weight: 300;
  line-height: var(--s-line-height-base);
}
.login__step-count[data-v-2e72b224] {
  color: var(--s-color-base-content-secondary);
  font-size: 14px;
}
.login__create-account-desc[data-v-2e72b224] {
  color: var(--s-color-base-content-primary);
  font-size: var(--s-font-size-extra-small);
  font-weight: 300;
  line-height: var(--s-line-height-base);
  padding: 0 calc(var(--s-basic-spacing) * 1.5);
}
.login__create-account-desc.success[data-v-2e72b224] {
  color: var(--s-color-status-success);
}
.login__create-account-desc.info[data-v-2e72b224] {
  color: var(--s-color-status-info);
}
.login__create-account-desc.warning[data-v-2e72b224] {
  color: var(--s-color-status-warning);
}
.login__create-account-desc.error[data-v-2e72b224] {
  color: var(--s-color-status-error);
}
.login .el-textarea__inner[data-v-2e72b224] {
  resize: none;
}
.login .json-upload[data-v-2e72b224] {
  display: none;
}
.login .input-textarea.s-textarea[data-v-2e72b224] {
  margin-bottom: 0;
}
.line[data-v-2e72b224] {
  width: 100%;
  display: flex;
  flex-direction: row;
  text-transform: uppercase;
  color: var(--s-color-base-content-secondary);
}
.line[data-v-2e72b224]::before, .line[data-v-2e72b224]::after {
  content: "";
  flex: 1 1;
  border-bottom: 2px solid var(--s-color-base-content-tertiary);
  margin: auto;
  margin-left: 10px;
  margin-right: 10px;
}
.eye-icon[data-v-2e72b224]:hover {
  cursor: pointer;
}
.upload-json .placeholder[data-v-2e72b224] {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.upload-json__icon[data-v-2e72b224] {
  color: var(--s-color-base-content-tertiary);
  margin-bottom: calc(var(--s-size-small) / 2);
}
.upload-json__icon.icon--error[data-v-2e72b224] {
  color: var(--s-color-theme-accent);
}
.upload-json__btn[data-v-2e72b224] {
  margin-top: calc(var(--s-size-small) / 2);
  height: 32px !important;
}
.upload-json__placeholder[data-v-2e72b224] {
  letter-spacing: var(--s-letter-spacing-small);
  color: var(--s-color-base-content-primary);
  font-size: calc(var(--s-size-small) / 2);
  text-align: center;
  padding: 0 50px;
}
.import-steps[data-v-2e72b224] {
  width: 100%;
}
.import-step[data-v-2e72b224] {
  display: flex;
  align-items: center;
  padding: calc(var(--s-basic-spacing) * 1.5) 0;
}
.import-step[data-v-2e72b224]:first-child {
  padding-top: 0;
}
.import-step[data-v-2e72b224]:last-child {
  padding-bottom: 0;
}
.import-step[data-v-2e72b224]:not(:last-child) {
  border-bottom: 1px solid var(--s-color-base-border-secondary);
}
.import-step__count[data-v-2e72b224] {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: var(--s-size-small);
  height: var(--s-size-small);
  font-size: 24px;
  font-weight: 300;
  background: var(--s-color-base-content-tertiary);
  color: var(--s-color-base-on-accent);
  box-shadow: var(--s-shadow-element-pressed);
  border-radius: 50%;
  text-align: center;
  margin-right: calc(var(--s-basic-spacing) * 1.5);
}
.import-step__text[data-v-2e72b224] {
  font-size: var(--s-font-size-medium);
}
.export-tutorial[data-v-2e72b224] {
  display: flex;
  flex-flow: column nowrap;
  gap: calc(var(--s-basic-spacing) * 1.5);
  width: 100%;
}
.export-tutorial-title[data-v-2e72b224] {
  font-weight: 600;
  font-size: var(--s-font-size-extra-small);
  text-transform: uppercase;
}
.export-tutorial-grid[data-v-2e72b224] {
  display: flex;
  gap: calc(var(--s-basic-spacing) * 1.5);
}
.export-tutorial-grid-item[data-v-2e72b224] {
  border-width: 1px;
  border-style: solid;
  border-color: transparent;
  border-radius: var(--s-border-radius-small);
  text-decoration: none;
}
.export-tutorial-grid-item[data-v-2e72b224]:hover {
  border-color: var(--s-color-base-content-secondary);
}
.export-tutorial-grid-item[data-v-2e72b224] {
  outline-offset: -1px;
}
.export-tutorial-grid-item[data-v-2e72b224]:focus:not(:active) {
  outline: 1px solid var(--s-color-outline);
}
.export-tutorial-grid-item[data-v-2e72b224] {
  width: calc(33.3333333333% - calc(var(--s-basic-spacing) / 2) * (3 - 1) / 3);
}
.extension-tutorial[data-v-2e72b224] {
  display: flex;
  flex-flow: column nowrap;
  align-items: center;
  gap: calc(var(--s-basic-spacing) / 2);
}
.extension-tutorial-logo[data-v-2e72b224] {
  width: var(--s-size-small);
  height: var(--s-size-small);
