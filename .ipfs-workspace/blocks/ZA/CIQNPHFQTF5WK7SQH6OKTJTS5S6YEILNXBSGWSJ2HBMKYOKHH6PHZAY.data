  font-size: var(--s-font-size-extra-small);
  line-height: var(--s-line-height-small);
  border-bottom: 1px solid var(--s-color-base-border-secondary);
}
.info-line + .info-line[data-v-a44303f0] {
  margin-top: calc(var(--s-basic-spacing) * 1.5);
}
.info-line[data-v-a44303f0]:first-child {
  margin-top: 0;
}
.info-line-container[data-v-a44303f0] {
  width: 100%;
}
.info-line-label[data-v-a44303f0] {
  margin-right: var(--s-basic-spacing);
  word-break: keep-all;
  text-transform: uppercase;
  text-align: left;
}
.info-line-content[data-v-a44303f0] {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: calc(var(--s-basic-spacing) * 0.5);
  flex-wrap: wrap;
  flex-grow: 1;
  word-break: break-all;
  text-align: right;
  margin-left: auto;
}
.info-line-value[data-v-a44303f0] {
  text-align: right;
  font-weight: 600;
}
.info-line .asset-symbol[data-v-a44303f0] {
  word-break: keep-all;
  white-space: nowrap;
}
.info-line .el-tooltip[data-v-a44303f0] {
  margin-top: -1px;
  margin-right: var(--s-basic-spacing);
  flex-shrink: 0;
}
.info-line .el-tooltip i[data-v-a44303f0] {
  margin-top: auto;
  margin-bottom: auto;
  display: block;
  color: var(--s-color-base-content-tertiary);
}
.info-line-icon[data-v-a44303f0] {
  position: relative;
  height: var(--s-size-mini);
  width: var(--s-size-mini);
  border-radius: var(--s-border-radius-small);
  color: inherit;
}
.info-line-icon[data-v-a44303f0]:hover {
  background-color: var(--s-color-base-background-hover);
  cursor: pointer;
}
.info-line-icon[data-v-a44303f0]:before {
  position: absolute;
  display: block;
  height: var(--s-icon-font-size-mini);
  width: var(--s-icon-font-size-mini);
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  font-size: var(--s-icon-font-size-mini);
}
.info-line-icon--left[data-v-a44303f0] {
  order: -1;
}
.info-line .el-button[data-v-a44303f0] {
  margin-left: var(--s-basic-spacing);
  margin-right: 0;
}
.info-line .token-logo[data-v-a44303f0] {
  margin-right: var(--s-basic-spacing);
}
.info-line p[data-v-a44303f0] {
  font-size: inherit;
}
.info-line .formatted-amount--fiat-value[data-v-a44303f0] {
  line-height: inherit;
}
.el-tooltip[data-v-a44303f0] {
