  display: flex;
  justify-content: center;
  flex-direction: column;
  margin-bottom: var(--s-size-mini);
  height: 250px;
}
.preview-image-confirm-nft .placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.preview-image-confirm-nft__content {
  margin: 0 auto;
  height: 250px !important;
  width: 250px !important;
  object-fit: cover;
  border-radius: calc(var(--s-border-radius-mini) * 0.75);
}
.preview-image-confirm-nft__icon-refresh {
  color: var(--s-color-base-content-tertiary) !important;
  font-size: var(--s-size-small) !important;
  margin-bottom: calc(var(--s-size-small) / 2);
  cursor: pointer;
}
.preview-image-confirm-nft__icon-refresh:hover {
  color: var(--s-color-base-content-secondary) !important;
}
.preview-image-confirm-nft__placeholder {
  letter-spacing: var(--s-letter-spacing-small);
  color: var(--s-color-base-content-primary);
  font-size: calc(var(--s-size-small) / 2);
  text-align: center;
  padding: 0 50px;
}
.nft-details-container {
  width: 100%;
}
.nft-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.nft-info__header {
  font-weight: 700;
  font-size: var(--s-font-size-large);
  text-transform: capitalize;
}
.nft-info__header--clickable {
  cursor: pointer;
}
.nft-info__header .s-icon-chevron-down-rounded-16 {
  display: inline-block;
  margin-left: var(--s-basic-spacing);
  height: var(--s-icon-font-size-small);
  width: var(--s-icon-font-size-small);
  transition: transform 0.3s;
  background-color: var(--s-color-base-content-secondary);
  color: var(--s-color-base-on-accent) !important;
  border-radius: 50%;
  text-align: left;
}
.nft-info__header--clicked .s-icon-chevron-down-rounded-16 {
  padding-right: calc(var(--s-basic-spacing) * 1.5);
  transform: rotate(180deg);
}
.nft-info__name {
  display: inline-block;
  max-width: 220px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 6px;
  line-height: var(--s-size-mini);
}
.nft-info__symbol {
  display: inline-block;
  font-weight: 400;
  overflow: hidden;
  font-size: calc(var(--s-size-small) / 2);
  color: var(--s-color-brand-day);
  line-height: calc(var(--s-size-mini) / 1.2);
}
.nft-info__desc {
  font-size: 14px;
  color: var(--s-color-brand-day);
  text-align: center;
  margin-bottom: 10px;
  max-width: 100%;
  overflow: hidden;
}
.nft-info__supply {
  border-top: 1px solid var(--s-color-base-border-secondary);
  padding-top: 10px;
  border-bottom: none;
  margin-bottom: 20px;
}`,map:void 0,media:void 0})},Gd,void 0,!1,void 0,!1,zt$3);let Jd=class extends Vue{};Jd=__decorate$2([OptionsDecorator],Jd);const Kd=Jd;var _d=function(){var Ya=this,ou=Ya.$createElement,vu=Ya._self._c||ou;return vu("div",{staticClass:"notification-enabling-pointer"},[vu("div",{staticClass:"notification-enabling-pointer__instructions"},[vu("div",{staticClass:"notification-enabling-pointer__text"},[Ya._t("default")],2)])])};_d._withStripped=!0;const $d=Dt$3({render:_d,staticRenderFns:[]},function(Ya){Ya&&Ya("data-v-63b119f8_0",{source:`.notification-enabling-pointer {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 90;
  width: 100%;
  height: 100%;
  background-color: #000;
  opacity: 0.9;
  z-index: 3000;
}
.notification-enabling-pointer__instructions {
  display: flex;
  position: relative;
}
.notification-enabling-pointer__text {
  position: relative;
  color: #fff;
  font-size: 19px;
}
.notification-enabling-pointer__text::before {
  content: "";
  background: url("data:image/png;base64,") no-repeat;
  width: 100%;
  height: 300px;
