  margin-left: calc(calc(var(--s-basic-spacing) * 3) * -1);
  margin-right: calc(calc(var(--s-basic-spacing) * 3) * -1);
}
.connection-items.el-scrollbar .el-scrollbar__wrap {
  overflow-x: hidden;
  margin-bottom: 0px !important;
}
.connection-items.el-scrollbar .el-scrollbar__wrap,
.connection-items.el-scrollbar .el-scrollbar__view {
  display: flex;
  flex: 1;
  flex-flow: column nowrap;
}
.connection-items.el-scrollbar .el-scrollbar__view {
  padding-left: calc(var(--s-basic-spacing) * 3);
  padding-right: calc(var(--s-basic-spacing) * 3);
}
.connection-items.el-scrollbar .el-scrollbar__bar.is-vertical {
  right: 2px;
}
.connection-items-list {
  display: flex;
  flex-flow: column nowrap;
}
.connection-items-list > .account-card {
  height: 60px;
}
.connection-items-list > .account-card {
  outline-offset: -1px;
}
.connection-items-list > .account-card:focus:not(:active) {
  outline: 1px solid var(--s-color-outline);
}
.connection-items-list > .account-card.s-card.neumorphic {
  border-width: 1px;
}
.connection-items-list > .account-card.s-card.neumorphic:hover {
  cursor: pointer;
  border-color: var(--s-color-base-content-secondary);
}
.connection-items-list > .account-card a.connection-action:focus:not(:active) {
  outline: 1px solid var(--s-color-outline);
  border-radius: var(--s-border-radius-small);
