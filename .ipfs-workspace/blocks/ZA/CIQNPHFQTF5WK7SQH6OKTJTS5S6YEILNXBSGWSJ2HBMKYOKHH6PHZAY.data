  display: flex;
  flex-direction: column;
  align-items: center;
  gap: calc(var(--s-basic-spacing) * 2);
}
.login-btn[data-v-f72c729c] {
  width: 100%;
}
.login-btn.el-button + .login-btn.el-button[data-v-f72c729c] {
  margin-left: 0;
}
.login__inputs[data-v-f72c729c] {
  display: flex;
  flex-direction: column;
  gap: calc(var(--s-basic-spacing) * 2);
  width: 100%;
}
.login__text[data-v-f72c729c] {
  color: var(--s-color-base-content-primary);
  font-size: var(--s-font-size-extra-small);
  font-weight: 300;
  line-height: var(--s-line-height-base);
}
.login__step-count[data-v-f72c729c] {
  color: var(--s-color-base-content-secondary);
  font-size: 14px;
}
.login__create-account-desc[data-v-f72c729c] {
  color: var(--s-color-base-content-primary);
  font-size: var(--s-font-size-extra-small);
  font-weight: 300;
  line-height: var(--s-line-height-base);
  padding: 0 calc(var(--s-basic-spacing) * 1.5);
}
.login__create-account-desc.success[data-v-f72c729c] {
  color: var(--s-color-status-success);
}
.login__create-account-desc.info[data-v-f72c729c] {
  color: var(--s-color-status-info);
}
.login__create-account-desc.warning[data-v-f72c729c] {
  color: var(--s-color-status-warning);
}
.login__create-account-desc.error[data-v-f72c729c] {
  color: var(--s-color-status-error);
}
.login .el-textarea__inner[data-v-f72c729c] {
  resize: none;
}
.login__text-advice[data-v-f72c729c] {
  text-align: center;
  margin-bottom: var(--s-basic-spacing);
  font-weight: 300;
}
.login__text-advice p[data-v-f72c729c]:first-child {
  margin-bottom: calc(var(--s-basic-spacing) * 2);
}
.login__text-advice p[data-v-f72c729c]:not(:first-child) {
  font-weight: 600;
}
.login__text-confirm[data-v-f72c729c] {
  width: 300px;
  text-align: center;
  font-weight: 300;
}
.login__error[data-v-f72c729c] {
  height: 20px;
  margin-bottom: calc(var(--s-basic-spacing) * 0.5);
}
.login__error-text[data-v-f72c729c] {
  color: var(--s-color-status-error);
}
.login__copy-seed[data-v-f72c729c] {
  margin: var(--s-basic-spacing) 0 calc(var(--s-basic-spacing) * 3) 0;
}
.login__order-container[data-v-f72c729c] {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px 8px;
  min-height: 74px;
}
.login__random-order[data-v-f72c729c] {
