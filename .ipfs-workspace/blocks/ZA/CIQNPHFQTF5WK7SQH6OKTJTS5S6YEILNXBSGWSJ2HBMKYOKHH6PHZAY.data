  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  text-align: center;
  font-size: var(--s-font-size-mini);
}
.add-asset-token__switch-btn[data-v-063cd3b8] {
  display: flex;
  margin-bottom: 14px;
}
