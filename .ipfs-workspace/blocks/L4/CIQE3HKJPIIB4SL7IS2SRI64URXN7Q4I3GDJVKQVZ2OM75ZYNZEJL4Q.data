  .help-container {
    position: absolute;
    top: 2%;
    right: 4%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: ${o.custom.smallGutterMargin};
    z-index: 3;
  }

  .help-button {
    cursor: pointer;
    display: inline-flex;
    border-radius: 100%;
    border: none;
    background: transparent;
  }

  .help-button svg {
    fill: ${o.palette.text.primary};
  }

  .help-popper__hidden {
    display: none;
  }

  .help-popper__exit {
    animation: scale-out 0.2s ease-in-out forwards;
  }

  .help-popper__visible {
    animation: scale-in 0.2s ease-in;
  }

  .help-popper {
    transform-origin: top right;
    background: ${o.palette.background.help};
    padding: ${o.custom.smallGutterMargin};
    border-radius: ${o.custom.buttonDefaultRadius}px;
  }

  .help-popper a {
    text-decoration: none;
    transition: 0.2s;
    display: inline-flex;
    align-items: center;
    gap: ${o.custom.gutterMargin};
  }

  .help-popper a:hover {
    opacity: 0.6;
  }

  .help-popper svg {
    fill: ${o.palette.text.primary};
  }

  .help-inner-icon {
    fill: ${o.palette.background.default};
  }

  @keyframes scale-in {
    from {
      transform: scale(0.7);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes scale-out {
    from {
      transform: scale(1);
      opacity: 1;
    }
    to {
      transform: scale(0.7);
      opacity: 0;
    }
  }
