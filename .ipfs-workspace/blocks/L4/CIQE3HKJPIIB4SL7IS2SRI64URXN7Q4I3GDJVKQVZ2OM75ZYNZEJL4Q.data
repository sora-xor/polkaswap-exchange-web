  .loader-container {
    height: 100%;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    background: ${o.palette.background.default};
  }


  .cede-loader-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: ${o.custom.imgSize.large};
    width: ${o.custom.imgSize.large};
    padding: 6px;
    overflow: hidden;
    border-radius: 25%;
    box-sizing: border-box;
  }

  .cede-loader-wrapper::before {
    content: "";
    position: absolute;
    top: -20px;
    bottom: -20px;
    left: -20px;
    right: -20px;
    background: linear-gradient(${o.palette.logoBorderColor}, ${o.palette.logoBorderColor}, ${o.palette.logoBorderColor}, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1));
    z-index: 0;
    border-radius: 50%;
    animation: spinner-spin 2s linear infinite;
  }

  @keyframes spinner-spin {
    100% {
      transform: rotate(360deg); 
    }
  }

  .cede-loader-img {
    height: 100%;
    width: 100%;
    z-index: 1;
  }
`,vv=()=>`
  <div id="cede-loader" class="loader-container">
    <div class="cede-loader-wrapper">
      <img class="cede-loader-img" src="${mv}" />
    </div>
  </div>
`,wv={style:yv,html:vv},bv="data:image/svg+xml;base64,",Sv=o=>`
  .modal-container {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    height: 100%;
    width: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    animation: fade-in 0.3s ease-in-out;
  }

  .modal {
    max-width: 100%;
    width: 600px;
    height: 500px;
    border-radius: 14px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background: ${o.palette.background.default};
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: 0px 4px 70px 50px #5EA6FF26;
  }

  .modal-header {
    display: flex;
    flex-direction: row-reverse;
    width: auto;
    min-height: 50px;
    padding: 8px;
  }

  .close-icon {
    width: 24px;
    height: 24px;
    fill: rgb(155, 155, 155);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: calc(100% - 50px);
    overflow: hidden;
    padding: 10px 50px 25px 50px;
    justify-content: space-between;
  }

  .modal-title {
    width: 100%;
  }

  .modal-title img {
    width: 110px;
    height: 110px;
  }

  .modal-title h1 {
    font-weight: 600;
    margin-top: 28px;
    font-size: 24px;
    color: ${o.palette.text.primary};
  }

  .modal-title h1 span {
    color: ${o.palette.primary.main};
  }

  .modal-title p {
    font-size: 14px;
    color: ${o.palette.text.secondary};
    line-height: 18px;
    font-weight: 400;
    margin-top: 20px;
  }

  .modal-title p.modal-content-last {
    margin-top: 35px;
  }

  .modal-title p strong {
    color: ${o.palette.text.secondary};
  }

  .modal-content-image:hover {
    box-shadow: 0px 0px 20px 14px rgba(94, 166, 255, 0.31);
  }
  
  .modal-content-image {
    margin-top: 20px;
    transition: box-shadow 0.3s ease-in-out;
    box-shadow: 0px 0px 0px 0px rgba(94, 166, 255, 0.31);
    height: 67px;
    width: 220px;
    border: 1px solid ${o.palette.cedeComponentHr};
    border-radius: 13px;
    padding: 0 10px;
    cursor: pointer;
  }

  .modal-banner-link {
    color: ${o.palette.text.secondary};
    margin-top: 20px;
  }
