  .error-container {
    height: 100%;
    text-align: center;
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: ${o.custom.gutterMargin} 0;
    gap: ${o.custom.gutterMargin};
  }
  .error-logo {
    height: ${o.custom.imgSize.large};
    width: ${o.custom.imgSize.large};
  }
  .error-title {
    color: ${o.palette.error.main};
  }
  .error-content {
    color: ${o.palette.error.main};
    text-align: center;
    font-size: ${o.typography(o.palette).body1.fontSize};;
    font-weight: normal;
  }
`,hv=(o,{error:e})=>`
  <section class="error-container">
    <div class="error-logo cede-logo">
      ${Hr}
    </div>
    <h1 class="error-title">
      Error
    </h1>
    <h2 class="error-content">
      ${e}
    </h2>
  </section>
