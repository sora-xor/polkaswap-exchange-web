  "main": "index.js",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "build:vue3": "VITE_DISABLE_COMPAT=true vite build",
    "analyze:store": "tsx ./scripts/analyze/store-usage.ts",
    "analyze:compat": "tsx ./scripts/analyze/compat-alias.ts",
    "compat:smoke": "tsx ./scripts/analyze/compat-smoke.ts",
    "preview": "vite preview",
    "ipfs:publish": "tsx ./scripts/ipfs/publish.ts",
    "ipfs:check": "node ./scripts/ipfs/check-browser.js",
    "ipfs:check:electron": "electron ./scripts/ipfs/check-electron.js",
    "ci:nightly": "yarn test:translation && yarn build:vue3",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall/fix-peer-deps.js",
    "electron:build": "electron-vite build",
    "electron:serve": "electron-vite dev",
    "lint": "eslint",
    "lang:generate": "tsx ./scripts/lang/generate.ts",
    "lang:fix": "tsx ./scripts/lang/fix.ts",
    "lang:diff": "tsx ./scripts/lang/diff-runner.ts",
    "lang:mt": "tsx ./scripts/lang/mt.ts",
    "kpi:report": "tsx ./scripts/kpi/report.ts",
    "test:unit": "node ./scripts/testing/run-vitest-unit.mjs",
    "test:ipfs": "node ./scripts/ipfs-smoke.mjs",
    "test:translation": "vitest run --config vitest.config.mjs --project translation --pass-with-no-tests",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:all": "yarn test:e2e tests/e2e/ui && yarn test:e2e:root && yarn test:e2e:live",
    "test:e2e:render": "env -u NO_COLOR playwright test tests/e2e/ui/route-rendering.spec.ts",
    "test:e2e:render:live": "env -u NO_COLOR PS_E2E_LIVE_NETWORK=1 playwright test tests/e2e/ui/live-runtime.spec.ts --grep \"route rendering matrix\"",
    "test:e2e:root": "env -u NO_COLOR PS_PLAYWRIGHT_REUSE_SERVER=0 PS_IPFS_TEST_PREFIX='' playwright test tests/e2e/ui/app.spec.ts tests/e2e/ui/navigation.spec.ts tests/e2e/ui/bridge-moonpay.spec.ts tests/e2e/ui/wallet-overlays.spec.ts tests/e2e/ui/bridge-route-overlays.spec.ts tests/e2e/ui/footer-dialogs.spec.ts tests/e2e/ui/stability.spec.ts tests/e2e/ui/route-rendering.spec.ts",
    "test:e2e:live": "env -u NO_COLOR PS_E2E_LIVE_NETWORK=1 playwright test tests/e2e/ui/live-runtime.spec.ts",
    "test:all": "yarn test:unit"
  },
