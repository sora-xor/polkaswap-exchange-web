  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "build:vue3": "vite build",
    "analyze:store": "tsx ./scripts/analyze/store-usage.ts",
    "analyze:compat": "tsx ./scripts/analyze/compat-alias.ts",
    "compat:smoke": "tsx ./scripts/analyze/compat-smoke.ts",
    "prepreview": "yarn build",
    "preview": "vite preview",
    "ipfs:publish": "tsx ./scripts/ipfs/publish.ts",
    "ipfs:purge:bunny": "node ./scripts/ipfs/purge-bunny.mjs",
    "ops:mof:check": "node ./scripts/ops/check-mof-rpc.mjs",
    "bots:collect:quotes": "tsx ./scripts/bots/collect-execution-quotes.ts",
    "bots:replay:episode": "tsx ./scripts/bots/replay-execution-episode.ts",
    "sorafs:package": "tsx ./scripts/sorafs/deploy.ts package",
    "sorafs:proposal": "tsx ./scripts/sorafs/deploy.ts proposal",
    "sorafs:publish": "tsx ./scripts/sorafs/deploy.ts publish",
    "sorafs:probe": "tsx ./scripts/sorafs/deploy.ts probe",
    "taira:package": "tsx ./scripts/sorafs/deploy.ts package --torii-url https://taira.sora.org --chain-id 809574f5-fee7-5e69-bfcf-52451e42d50f --network-prefix 369 --env-config env.taira.json",
    "taira:proposal": "tsx ./scripts/sorafs/deploy.ts proposal --torii-url https://taira.sora.org --chain-id 809574f5-fee7-5e69-bfcf-52451e42d50f --network-prefix 369 --env-config env.taira.json",
    "taira:publish": "tsx ./scripts/sorafs/deploy.ts publish --torii-url https://taira.sora.org --chain-id 809574f5-fee7-5e69-bfcf-52451e42d50f --network-prefix 369 --env-config env.taira.json",
    "taira:probe": "tsx ./scripts/sorafs/deploy.ts probe --torii-url https://taira.sora.org --chain-id 809574f5-fee7-5e69-bfcf-52451e42d50f --network-prefix 369",
    "ipfs:check": "node ./scripts/ipfs/check-browser.js",
    "ipfs:check:electron": "electron ./scripts/ipfs/check-electron.js",
    "ci:nightly": "yarn test:translation && yarn build:vue3",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall/fix-peer-deps.js",
    "electron:build": "electron-vite build",
    "electron:serve": "electron-vite dev",
    "lint": "eslint",
    "lang:generate": "tsx ./scripts/lang/generate.ts",
    "lang:fix": "tsx ./scripts/lang/fix.ts",
    "lang:fill-missing": "tsx ./scripts/lang/fill-missing.ts",
    "lang:diff": "tsx ./scripts/lang/diff-runner.ts",
    "lang:mt": "tsx ./scripts/lang/mt.ts",
    "lang:refresh:batch": "tsx ./scripts/lang/refresh-existing-batch.ts",
    "lang:semantic": "tsx ./scripts/lang/semantic-locales.ts",
    "kpi:report": "tsx ./scripts/kpi/report.ts",
    "test:unit": "node ./scripts/testing/run-vitest-unit.mjs",
    "test:ipfs": "node ./scripts/ipfs-smoke.mjs",
    "test:translation": "vitest run --config vitest.config.mjs --project translation --pass-with-no-tests",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:all": "yarn test:e2e tests/e2e/ui && yarn test:e2e:root && yarn test:e2e:live",
    "test:e2e:render": "env -u NO_COLOR playwright test tests/e2e/ui/route-rendering.spec.ts",
    "test:e2e:render:live": "env -u NO_COLOR PS_E2E_LIVE_NETWORK=1 playwright test tests/e2e/ui/live-runtime.spec.ts --grep \"route rendering matrix\"",
    "test:e2e:root": "env -u NO_COLOR PS_PLAYWRIGHT_REUSE_SERVER=0 PS_IPFS_TEST_PREFIX='' playwright test tests/e2e/ui/app.spec.ts tests/e2e/ui/navigation.spec.ts tests/e2e/ui/bridge-moonpay.spec.ts tests/e2e/ui/wallet-overlays.spec.ts tests/e2e/ui/bridge-route-overlays.spec.ts tests/e2e/ui/footer-dialogs.spec.ts tests/e2e/ui/stability.spec.ts tests/e2e/ui/route-rendering.spec.ts",
    "test:e2e:live": "env -u NO_COLOR PS_E2E_LIVE_NETWORK=1 playwright test tests/e2e/ui/live-runtime.spec.ts",
    "test:all": "yarn test:unit",
    "test:e2e:agent:smoke": "yarn build --logLevel error && node ./scripts/playwright/agent-trading-smoke.mjs",
    "agent:runner": "node ./examples/agent-runner/agent-runner.mjs",
    "agent:mcp": "node ./examples/agent-mcp/index.mjs",
    "test:e2e:swap:smoke": "node ./scripts/playwright/swap-smoke.mjs",
    "test:e2e:safari:smoke": "node ./scripts/playwright/safari-smoke.mjs",
    "test:e2e:wallet:extensions": "node ./scripts/playwright/ensure-wallet-extensions.mjs",
    "test:e2e:wallet:matrix": "node ./scripts/playwright/wallet-matrix.mjs",
    "test:e2e:wallet:matrix:fresh": "WALLET_MATRIX_FRESH=1 node ./scripts/playwright/wallet-matrix.mjs",
    "security:audit": "node ./scripts/security/audit.mjs",
    "security:audit:vendor": "node ./scripts/security/audit-vendor.mjs"
  },
